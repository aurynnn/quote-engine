---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quote Engine - Style 7</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white font-sans">
    <!-- Starfield effect -->
    <div class="fixed inset-0 -z-10">
      <div class="absolute inset-0" id="stars"></div>
    </div>

    <header class="relative z-10">
      <div class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between">
        <span class="text-2xl font-bold flex items-center gap-2">
          <span class="text-3xl">⚡</span> Quote Engine
        </span>
        <div class="flex items-center gap-4">
          <a href="/dashboard" class="text-zinc-300 hover:text-white transition">Dashboard</a>
          <a href="/auth/signup" class="bg-white text-slate-900 px-5 py-2 rounded-lg font-semibold hover:bg-zinc-100 transition">Start</a>
        </div>
      </div>
    </header>

    <main class="relative z-10 pt-28">
      <section class="max-w-4xl mx-auto px-6 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 text-zinc-400 text-sm mb-8">
          <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
          Now with AI-powered generation
        </div>
        
        <h1 class="text-5xl md:text-7xl font-bold mb-8 leading-tight">
          Quotes made<br />
          <span class="bg-gradient-to-r from-yellow-400 via-orange-400 to-red-400 bg-clip-text text-transparent">ridiculously easy</span>
        </h1>
        
        <p class="text-xl text-zinc-400 mb-12 max-w-2xl mx-auto">
          Stop wasting time on manual calculations. Our AI understands your pricing and generates perfect quotes instantly.
        </p>
        
        <!-- Big CTA -->
        <div class="flex flex-col items-center gap-6">
          <a href="/dashboard" class="group relative inline-flex items-center justify-center px-10 py-5 text-xl font-bold text-black bg-white rounded-2xl overflow-hidden transition-transform hover:scale-105">
            <span class="relative z-10">Start Generating Quotes</span>
            <div class="absolute inset-0 bg-gradient-to-r from-yellow-400 via-orange-400 to-red-400 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </a>
          <p class="text-zinc-500 text-sm">No signup required to try</p>
        </div>
      </section>

      <!-- Quick steps -->
      <section class="max-w-3xl mx-auto px-6 mt-24">
        <div class="flex justify-center gap-12 text-center">
          <div>
            <div class="text-3xl font-bold mb-1">1</div>
            <div class="text-zinc-500 text-sm">Upload</div>
          </div>
          <div class="text-zinc-600 text-2xl">→</div>
          <div>
            <div class="text-3xl font-bold mb-1">2</div>
            <div class="text-zinc-500 text-sm">Describe</div>
          </div>
          <div class="text-zinc-600 text-2xl">→</div>
          <div>
            <div class="text-3xl font-bold mb-1">3</div>
            <div class="text-zinc-500 text-sm">Done</div>
          </div>
        </div>
      </section>
    </main>

    <script>
      // Simple stars
      const stars = document.getElementById('stars');
      for (let i = 0; i < 100; i++) {
        const star = document.createElement('div');
        star.className = 'absolute w-1 h-1 bg-white rounded-full';
        star.style.left = Math.random() * 100 + '%';
        star.style.top = Math.random() * 100 + '%';
        star.style.opacity = Math.random() * 0.5 + 0.2;
        star.style.animation = `twinkle ${Math.random() * 3 + 2}s infinite`;
        stars.appendChild(star);
      }
    </script>
    
    <style>
      @keyframes twinkle {
        0%, 100% { opacity: 0.2; }
        50% { opacity: 0.8; }
      }
    </style>
  </body>
</html>
