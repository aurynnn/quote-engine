---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quote Engine - Style 3</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <!-- Radial gradient -->
    <div class="fixed inset-0 -z-10">
      <div class="absolute inset-0 bg-gradient-to-b from-[#0a0a0f] via-[#0f0f1a] to-[#0a0a0f]"></div>
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-orange-500/10 rounded-full blur-[100px]"></div>
    </div>

    <header class="fixed top-0 left-0 right-0 z-50 border-b border-white/5">
      <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-gradient-to-br from-orange-400 to-red-500 rounded-lg"></div>
          <span class="text-xl font-semibold">Quote Engine</span>
        </div>
        <a href="/dashboard" class="bg-white text-black px-5 py-2 rounded-lg font-medium hover:bg-gray-100 transition">Try Now</a>
      </div>
    </header>

    <main class="pt-36">
      <section class="max-w-4xl mx-auto px-6 text-center">
        <h1 class="text-7xl font-bold mb-6">
          Quote Generation<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 via-red-400 to-pink-400">Reimagined</span>
        </h1>
        <p class="text-xl text-zinc-400 mb-12 max-w-xl mx-auto">
          The fastest way to create professional quotes. Upload, describe, done.
        </p>
        
        <!-- Demo input -->
        <div class="max-w-lg mx-auto bg-white/5 border border-white/10 rounded-2xl p-2 flex">
          <input type="text" placeholder="Describe your project..." class="flex-1 bg-transparent px-4 py-3 outline-none text-white placeholder-zinc-500" />
          <button class="bg-gradient-to-r from-orange-500 to-red-500 px-6 py-3 rounded-xl font-semibold">Generate</button>
        </div>
        
        <p class="mt-6 text-sm text-zinc-500">No credit card required • Free to start</p>
      </section>
    </main>
  </body>
</html>
