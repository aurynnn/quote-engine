---
import '../../styles/global.css';

const userId = '507f1f77bcf86cd799439011';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Analytics - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <div class="fixed inset-0 -z-10 bg-[#0a0a0f]"></div>

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 bottom-0 w-56 bg-[#0c0c12] border-r border-white/[0.06] p-4 z-20">
      <a href="/" class="flex items-center gap-3 mb-6 px-2">
        <div class="w-7 h-7 bg-red-600 rounded-lg"></div>
        <span class="text-lg font-semibold">Quote Engine</span>
      </a>
      
      <nav class="space-y-1">
        <a href="/dashboard" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-zinc-400 hover:bg-white/[0.04] hover:text-white transition text-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/analytics" class="flex items-center gap-3 px-3 py-2.5 rounded-lg bg-white/[0.06] text-white font-medium text-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          Analytics
        </a>
        <a href="/dashboard/quotes" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-zinc-400 hover:bg-white/[0.04] hover:text-white transition text-sm" data-requires="template:true">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/templates" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-zinc-400 hover:bg-white/[0.04] hover:text-white transition text-sm" data-requires="prices:true">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>
          Templates
        </a>
        <a href="/dashboard/prices" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-zinc-400 hover:bg-white/[0.04] hover:text-white transition text-sm" data-requires="prices:true">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/rules" class="sidebar-item flex items-center gap-3 px-3 py-2.5 rounded-lg text-zinc-400 hover:bg-white/[0.04] hover:text-white transition text-sm" data-requires="rules:true">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
        <a href="/dashboard/settings" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-zinc-400 hover:bg-white/[0.04] hover:text-white transition text-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m-6-4a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          Settings
        </a>
        <a href="/dashboard/subscription" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-zinc-400 hover:bg-white/[0.04] hover:text-white transition text-sm">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
          Subscription
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="ml-56 p-6">
      <div class="max-w-6xl">
        <!-- Header -->
        <div class="flex items-center justify-between mb-6">
          <div>
            <h1 class="text-2xl font-bold text-white">Analytics</h1>
            <p class="text-sm text-zinc-500">Track your quote performance and revenue</p>
          </div>
          <div class="flex items-center gap-3">
            <button id="theme-toggle" class="p-2 rounded-lg bg-white/[0.06] hover:bg-white/[0.1] transition" title="Toggle theme">
              <svg class="w-4 h-4 moon-icon text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
              <svg class="w-4 h-4 sun-icon text-zinc-400 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            </button>
            <button onclick="resetDemoData()" class="px-3 py-1.5 bg-white/[0.06] hover:bg-white/[0.1] text-zinc-400 hover:text-white rounded-lg text-xs transition">
              Reset Demo Data
            </button>
          </div>
        </div>

        <!-- Quote Statistics -->
        <div class="grid grid-cols-4 gap-4 mb-6">
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-4">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-8 h-8 rounded-lg bg-blue-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              </div>
              <span class="text-xs text-zinc-500">Total Quotes</span>
            </div>
            <div class="text-2xl font-bold text-white" id="stat-total">0</div>
          </div>
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-4">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-8 h-8 rounded-lg bg-emerald-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <span class="text-xs text-zinc-500">Accepted</span>
            </div>
            <div class="text-2xl font-bold text-emerald-400" id="stat-accepted">0</div>
            <div class="text-xs text-zinc-500 mt-1" id="stat-accepted-pct">0%</div>
          </div>
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-4">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-8 h-8 rounded-lg bg-red-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              </div>
              <span class="text-xs text-zinc-500">Rejected</span>
            </div>
            <div class="text-2xl font-bold text-red-400" id="stat-rejected">0</div>
            <div class="text-xs text-zinc-500 mt-1" id="stat-rejected-pct">0%</div>
          </div>
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-4">
            <div class="flex items-center gap-2 mb-2">
              <div class="w-8 h-8 rounded-lg bg-amber-500/20 flex items-center justify-center">
                <svg class="w-4 h-4 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <span class="text-xs text-zinc-500">Pending</span>
            </div>
            <div class="text-2xl font-bold text-amber-400" id="stat-pending">0</div>
            <div class="text-xs text-zinc-500 mt-1" id="stat-pending-pct">0%</div>
          </div>
        </div>

        <!-- Revenue Chart & Conversion Funnel -->
        <div class="grid lg:grid-cols-3 gap-6 mb-6">
          <!-- Revenue Over Time -->
          <div class="lg:col-span-2 bg-[#0c0c12] border border-white/[0.06] rounded-xl p-5">
            <h2 class="text-base font-semibold text-white mb-4">Revenue Over Time</h2>
            <div class="h-64">
              <canvas id="revenueChart"></canvas>
            </div>
          </div>
          
          <!-- Conversion Funnel -->
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-5">
            <h2 class="text-base font-semibold text-white mb-4">Conversion Funnel</h2>
            <div class="space-y-3" id="funnel-container">
              <!-- Funnel will be rendered by JS -->
            </div>
          </div>
        </div>

        <!-- Top Clients & Popular Services -->
        <div class="grid lg:grid-cols-2 gap-6 mb-6">
          <!-- Top Clients -->
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-5">
            <h2 class="text-base font-semibold text-white mb-4">Top Clients</h2>
            <div class="space-y-3" id="top-clients">
              <!-- Rendered by JS -->
            </div>
          </div>

          <!-- Popular Services -->
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-5">
            <h2 class="text-base font-semibold text-white mb-4">Popular Services</h2>
            <div class="space-y-3" id="popular-services">
              <!-- Rendered by JS -->
            </div>
          </div>
        </div>

        <!-- Monthly Trends -->
        <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-5 mb-6">
          <h2 class="text-base font-semibold text-white mb-4">Monthly Trends</h2>
          <div class="h-64">
            <canvas id="trendsChart"></canvas>
          </div>
        </div>

        <!-- Revenue Stats Summary -->
        <div class="grid grid-cols-3 gap-4">
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-4">
            <div class="text-xs text-zinc-500 mb-1">Total Revenue</div>
            <div class="text-xl font-bold text-white" id="total-revenue">€0</div>
          </div>
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-4">
            <div class="text-xs text-zinc-500 mb-1">Avg. Quote Value</div>
            <div class="text-xl font-bold text-white" id="avg-quote-value">€0</div>
          </div>
          <div class="bg-[#0c0c12] border border-white/[0.06] rounded-xl p-4">
            <div class="text-xs text-zinc-500 mb-1">Win Rate</div>
            <div class="text-xl font-bold text-emerald-400" id="win-rate">0%</div>
          </div>
        </div>
      </div>
    </main>

    <script>
      // Demo data storage
      const STORAGE_KEY = 'quoteEngineAnalytics';
      
      function generateDemoData() {
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        const currentMonth = new Date().getMonth();
        
        const clients = [
          { name: 'Acme Corp', value: 45000 },
          { name: 'TechStart Inc', value: 32000 },
          { name: 'Global Solutions', value: 28000 },
          { name: 'Innovate Ltd', value: 21000 },
          { name: 'Digital Dynamics', value: 18000 }
        ];
        
        const services = [
          { name: 'Web Development', count: 45 },
          { name: 'API Integration', count: 38 },
          { name: 'UI/UX Design', count: 32 },
          { name: 'Cloud Setup', count: 25 },
          { name: 'Consulting', count: 18 }
        ];
        
        // Generate monthly data
        const monthlyData = months.slice(0, currentMonth + 1).map((month, i) => {
          const baseRevenue = 8000 + Math.random() * 12000;
          const accepted = Math.floor(3 + Math.random() * 5);
          const rejected = Math.floor(1 + Math.random() * 3);
          const pending = Math.floor(1 + Math.random() * 3);
          
          return {
            month,
            revenue: Math.round(baseRevenue),
            quotes: accepted + rejected + pending,
            accepted,
            rejected,
            pending
          };
        });
        
        return {
          clients,
          services,
          monthlyData,
          totalQuotes: monthlyData.reduce((sum, m) => sum + m.quotes, 0),
          totalAccepted: monthlyData.reduce((sum, m) => sum + m.accepted, 0),
          totalRejected: monthlyData.reduce((sum, m) => sum + m.rejected, 0),
          totalPending: monthlyData.reduce((sum, m) => sum + m.pending, 0),
          totalRevenue: monthlyData.reduce((sum, m) => sum + m.revenue, 0)
        };
      }
      
      function loadData() {
        let data = localStorage.getItem(STORAGE_KEY);
        if (!data) {
          data = generateDemoData();
          localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        } else {
          data = JSON.parse(data);
        }
        return data;
      }
      
      function resetDemoData() {
        localStorage.removeItem(STORAGE_KEY);
        location.reload();
      }
      
      // Initialize
      const data = loadData();
      
      // Update statistics
      document.getElementById('stat-total').textContent = data.totalQuotes;
      document.getElementById('stat-accepted').textContent = data.totalAccepted;
      document.getElementById('stat-rejected').textContent = data.totalRejected;
      document.getElementById('stat-pending').textContent = data.totalPending;
      
      const acceptedPct = data.totalQuotes > 0 ? Math.round((data.totalAccepted / data.totalQuotes) * 100) : 0;
      const rejectedPct = data.totalQuotes > 0 ? Math.round((data.totalRejected / data.totalQuotes) * 100) : 0;
      const pendingPct = data.totalQuotes > 0 ? Math.round((data.totalPending / data.totalQuotes) * 100) : 0;
      
      document.getElementById('stat-accepted-pct').textContent = acceptedPct + '% rate';
      document.getElementById('stat-rejected-pct').textContent = rejectedPct + '% rate';
      document.getElementById('stat-pending-pct').textContent = pendingPct + '% rate';
      
      document.getElementById('total-revenue').textContent = '€' + data.totalRevenue.toLocaleString();
      document.getElementById('avg-quote-value').textContent = '€' + Math.round(data.totalRevenue / data.totalAccepted).toLocaleString();
      document.getElementById('win-rate').textContent = acceptedPct + '%';
      
      // Revenue Chart
      const revenueCtx = document.getElementById('revenueChart').getContext('2d');
      new Chart(revenueCtx, {
        type: 'line',
        data: {
          labels: data.monthlyData.map(d => d.month),
          datasets: [{
            label: 'Revenue (€)',
            data: data.monthlyData.map(d => d.revenue),
            borderColor: '#ef4444',
            backgroundColor: 'rgba(239, 68, 68, 0.1)',
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#ef4444',
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          },
          scales: {
            x: {
              grid: {
                color: 'rgba(255,255,255,0.06)'
              },
              ticks: {
                color: '#71717a'
              }
            },
            y: {
              grid: {
                color: 'rgba(255,255,255,0.06)'
              },
              ticks: {
                color: '#71717a',
                callback: function(value) {
                  return '€' + value.toLocaleString();
                }
              }
            }
          }
        }
      });
      
      // Conversion Funnel
      const funnelData = [
        { label: 'Created', value: data.totalQuotes, color: 'bg-blue-500' },
        { label: 'Sent', value: Math.round(data.totalQuotes * 0.92), color: 'bg-purple-500' },
        { label: 'Viewed', value: Math.round(data.totalQuotes * 0.78), color: 'bg-amber-500' },
        { label: 'Accepted', value: data.totalAccepted, color: 'bg-emerald-500' }
      ];
      
      const funnelContainer = document.getElementById('funnel-container');
      const maxValue = funnelData[0].value;
      
      funnelData.forEach((item, index) => {
        const percentage = (item.value / maxValue) * 100;
        const html = `
          <div class="relative">
            <div class="flex items-center justify-between text-sm mb-1">
              <span class="text-zinc-400">${item.label}</span>
              <span class="text-white font-medium">${item.value}</span>
            </div>
            <div class="h-2 bg-white/[0.06] rounded-full overflow-hidden">
              <div class="h-full ${item.color} rounded-full transition-all duration-500" style="width: ${percentage}%"></div>
            </div>
          </div>
        `;
        funnelContainer.innerHTML += html;
      });
      
      // Top Clients
      const clientsContainer = document.getElementById('top-clients');
      data.clients.forEach((client, index) => {
        const maxValue = data.clients[0].value;
        const percentage = (client.value / maxValue) * 100;
        const html = `
          <div class="flex items-center gap-3">
            <div class="w-6 h-6 rounded-full bg-zinc-800 flex items-center justify-center text-xs font-medium text-zinc-400">${index + 1}</div>
            <div class="flex-1">
              <div class="flex items-center justify-between text-sm mb-1">
                <span class="text-white">${client.name}</span>
                <span class="text-zinc-400">€${client.value.toLocaleString()}</span>
              </div>
              <div class="h-1 bg-white/[0.06] rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-red-500 to-rose-500 rounded-full" style="width: ${percentage}%"></div>
              </div>
            </div>
          </div>
        `;
        clientsContainer.innerHTML += html;
      });
      
      // Popular Services
      const servicesContainer = document.getElementById('popular-services');
      data.services.forEach((service, index) => {
        const maxValue = data.services[0].count;
        const percentage = (service.count / maxValue) * 100;
        const colors = ['bg-red-500', 'bg-rose-500', 'bg-orange-500', 'bg-amber-500', 'bg-yellow-500'];
        const html = `
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg ${colors[index]} flex items-center justify-center text-sm">${service.count}</div>
            <div class="flex-1">
              <div class="flex items-center justify-between text-sm mb-1">
                <span class="text-white">${service.name}</span>
                <span class="text-zinc-400">${service.count} quotes</span>
              </div>
              <div class="h-1 bg-white/[0.06] rounded-full overflow-hidden">
                <div class="h-full ${colors[index]} rounded-full" style="width: ${percentage}%"></div>
              </div>
            </div>
          </div>
        `;
        servicesContainer.innerHTML += html;
      });
      
      // Monthly Trends Chart
      const trendsCtx = document.getElementById('trendsChart').getContext('2d');
      new Chart(trendsCtx, {
        type: 'bar',
        data: {
          labels: data.monthlyData.map(d => d.month),
          datasets: [
            {
              label: 'Accepted',
              data: data.monthlyData.map(d => d.accepted),
              backgroundColor: '#10b981',
              borderRadius: 4
            },
            {
              label: 'Rejected',
              data: data.monthlyData.map(d => d.rejected),
              backgroundColor: '#ef4444',
              borderRadius: 4
            },
            {
              label: 'Pending',
              data: data.monthlyData.map(d => d.pending),
              backgroundColor: '#f59e0b',
              borderRadius: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'top',
              labels: {
                color: '#71717a',
                usePointStyle: true,
                padding: 20
              }
            }
          },
          scales: {
            x: {
              stacked: true,
              grid: {
                display: false
              },
              ticks: {
                color: '#71717a'
              }
            },
            y: {
              stacked: true,
              grid: {
                color: 'rgba(255,255,255,0.06)'
              },
              ticks: {
                color: '#71717a'
              }
            }
          }
        }
      });

      // Theme
      function initTheme() {
        const saved = localStorage.getItem('theme') || 'dark';
        if (saved === 'light') {
          document.documentElement.classList.add('light');
          const sunIcon = document.querySelector('.sun-icon');
          const moonIcon = document.querySelector('.moon-icon');
          if (sunIcon) sunIcon.classList.remove('hidden');
          if (moonIcon) moonIcon.classList.add('hidden');
        }
      }
      
      function toggleTheme() {
        const isLight = document.documentElement.classList.toggle('light');
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
        const sunIcon = document.querySelector('.sun-icon');
        const moonIcon = document.querySelector('.moon-icon');
        if (sunIcon) sunIcon.classList.toggle('hidden', !isLight);
        if (moonIcon) moonIcon.classList.toggle('hidden', isLight);
      }
      
      document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
      initTheme();
    </script>
  </body>
</html>
