---
import '../../styles/global.css';

const userId = '507f1f77bcf86cd799439011';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Subscription - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <div class="fixed inset-0 -z-10 bg-gradient-to-br from-[#0a0a0f] via-[#0f0f14] to-[#0a0a0f]"></div>

    <aside class="fixed left-0 top-0 bottom-0 w-64 bg-[#0c0c12]/95 backdrop-blur-xl border-r border-white/[0.06] p-6 z-20">
      <a href="/" class="flex items-center gap-3 mb-8">
        <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-rose-600 rounded-lg"></div>
        <span class="text-xl font-semibold">Quote Engine</span>
      </a>
      <nav class="space-y-1">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/quotes" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/prices" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/rules" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
        <a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m-6-4a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          Settings
        </a>
      </nav>
    </aside>

    <main class="ml-64 p-8 relative z-10">
      <div class="max-w-5xl">
        <h1 class="text-3xl font-bold mb-2">💳 Subscription</h1>
        <p class="text-zinc-400 mb-8">Choose the plan that fits your business needs</p>

        <!-- Current Plan -->
        <div id="current-plan" class="bg-gradient-to-r from-red-500/10 to-rose-500/10 border border-red-500/20 rounded-2xl p-6 mb-8 hidden">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm text-zinc-400">Current Plan</p>
              <h2 class="text-2xl font-bold text-white">Free</h2>
              <p class="text-zinc-400 text-sm mt-1">5 quotes this month</p>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold">€0<span class="text-sm font-normal text-zinc-400">/month</span></p>
              <button id="manage-btn" class="mt-2 px-4 py-2 bg-red-600 hover:bg-red-500 rounded-lg text-sm font-medium transition">
                Manage Subscription
              </button>
            </div>
          </div>
        </div>

        <!-- Pricing Plans -->
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <!-- Free -->
          <div class="bg-white/[0.03] border border-white/[0.08] rounded-2xl p-6" data-plan="free">
            <h3 class="text-xl font-bold mb-2">Free</h3>
            <p class="text-3xl font-bold mb-4">€0<span class="text-sm font-normal text-zinc-400">/mo</span></p>
            <ul class="space-y-3 mb-6 text-sm text-zinc-400">
              <li class="flex items-center gap-2">✓ 5 quotes/month</li>
              <li class="flex items-center gap-2">✓ Basic Excel upload</li>
              <li class="flex items-center gap-2">✓ Email support</li>
            </ul>
            <button disabled class="w-full py-3 bg-white/[0.08] border border-white/[0.08] rounded-xl font-medium opacity-50 cursor-not-allowed">
              Current Plan
            </button>
          </div>

          <!-- Starter -->
          <div class="bg-white/[0.03] border border-white/[0.08] rounded-2xl p-6" data-plan="starter">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-xl font-bold">Starter</h3>
              <span class="text-xs bg-blue-500/20 text-blue-400 px-2 py-1 rounded-full">Popular</span>
            </div>
            <p class="text-3xl font-bold mb-4">€29<span class="text-sm font-normal text-zinc-400">/mo</span></p>
            <ul class="space-y-3 mb-6 text-sm text-zinc-400">
              <li class="flex items-center gap-2">✓ 25 quotes/month</li>
              <li class="flex items-center gap-2">✓ Excel upload & parsing</li>
              <li class="flex items-center gap-2">✓ Priority email</li>
              <li class="flex items-center gap-2">✓ Export to PDF</li>
            </ul>
            <button data-plan-id="starter" class="upgrade-btn w-full py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-medium transition">
              Upgrade
            </button>
          </div>

          <!-- Pro -->
          <div class="bg-white/[0.03] border border-white/[0.08] rounded-2xl p-6" data-plan="pro">
            <h3 class="text-xl font-bold mb-2">Pro</h3>
            <p class="text-3xl font-bold mb-4">€79<span class="text-sm font-normal text-zinc-400">/mo</span></p>
            <ul class="space-y-3 mb-6 text-sm text-zinc-400">
              <li class="flex items-center gap-2">✓ 100 quotes/month</li>
              <li class="flex items-center gap-2">✓ Advanced knowledge base</li>
              <li class="flex items-center gap-2">✓ Custom templates</li>
              <li class="flex items-center gap-2">✓ Client management</li>
              <li class="flex items-center gap-2">✓ API access</li>
            </ul>
            <button data-plan-id="pro" class="upgrade-btn w-full py-3 bg-gradient-to-r from-red-500 to-rose-600 hover:from-red-400 hover:to-rose-500 text-white rounded-xl font-medium transition">
              Upgrade
            </button>
          </div>

          <!-- Enterprise -->
          <div class="bg-white/[0.03] border border-white/[0.08] rounded-2xl p-6" data-plan="enterprise">
            <h3 class="text-xl font-bold mb-2">Enterprise</h3>
            <p class="text-3xl font-bold mb-4">€199<span class="text-sm font-normal text-zinc-400">/mo</span></p>
            <ul class="space-y-3 mb-6 text-sm text-zinc-400">
              <li class="flex items-center gap-2">✓ Unlimited quotes</li>
              <li class="flex items-center gap-2">✓ Unlimited knowledge base</li>
              <li class="flex items-center gap-2">✓ White-label</li>
              <li class="flex items-center gap-2">✓ Dedicated support</li>
              <li class="flex items-center gap-2">✓ Custom integrations</li>
            </ul>
            <button data-plan-id="enterprise" class="upgrade-btn w-full py-3 bg-white/[0.08] hover:bg-white/[0.12] border border-white/[0.08] rounded-xl font-medium transition">
              Contact Us
            </button>
          </div>
        </div>

        <!-- Payment Methods -->
        <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
          <h2 class="text-lg font-semibold mb-4">💳 Payment Methods</h2>
          <div class="flex items-center justify-between py-4 border-b border-white/[0.06]">
            <div class="flex items-center gap-4">
              <div class="w-12 h-8 bg-zinc-700 rounded flex items-center justify-center">
                <span class="text-xs font-bold">VISA</span>
              </div>
              <div>
                <p class="font-medium">•••• •••• •••• 4242</p>
                <p class="text-sm text-zinc-400">Expires 12/26</p>
              </div>
            </div>
            <span class="text-xs bg-emerald-500/20 text-emerald-400 px-2 py-1 rounded-full">Default</span>
          </div>
          <button class="mt-4 px-4 py-2 bg-white/[0.08] hover:bg-white/[0.12] border border-white/[0.08] rounded-lg text-sm font-medium transition">
            + Add Payment Method
          </button>
        </div>

        <!-- Billing History -->
        <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 mt-6">
          <h2 class="text-lg font-semibold mb-4">📋 Billing History</h2>
          <table class="w-full">
            <thead>
              <tr class="text-left text-zinc-400 text-sm">
                <th class="pb-3">Date</th>
                <th class="pb-3">Description</th>
                <th class="pb-3">Amount</th>
                <th class="pb-3">Status</th>
                <th class="pb-3"></th>
              </tr>
            </thead>
            <tbody class="text-sm">
              <tr class="border-t border-white/[0.06]">
                <td class="py-3 text-zinc-400">-</td>
                <td class="py-3">Free Plan</td>
                <td class="py-3">€0.00</td>
                <td class="py-3"><span class="text-emerald-400">Active</span></td>
                <td class="py-3 text-right"></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <script>
      // Upgrade button handler
      document.querySelectorAll('.upgrade-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const planId = btn.getAttribute('data-plan-id');
          if (!planId) return;

          btn.textContent = 'Processing...';
          btn.setAttribute('disabled', 'true');

          try {
            const res = await fetch('/api/stripe/checkout', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'create-checkout', planId })
            });

            const data = await res.json();
            if (data.url) {
              window.location.href = data.url;
            } else {
              btn.textContent = 'Error - Try Again';
              btn.classList.add('bg-red-600');
            }
          } catch (err) {
            console.error(err);
            btn.textContent = 'Error - Try Again';
          }
        });
      });

      // Show current plan (mock for now)
      document.getElementById('current-plan')?.classList.remove('hidden');
    </script>
  </body>
</html>
