---
import '../../styles/global.css';

const userId = '507f1f77bcf86cd799439011';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rules - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <div class="fixed inset-0 -z-10 bg-gradient-to-br from-[#0a0a0f] via-[#0f0f14] to-[#0a0a0f]"></div>

    <aside class="fixed left-0 top-0 bottom-0 w-64 bg-[#0c0c12]/95 backdrop-blur-xl border-r border-white/[0.06] p-6 z-20">
      <a href="/" class="flex items-center gap-3 mb-8">
        <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-rose-600 rounded-lg"></div>
        <span class="text-xl font-semibold">Quote Engine</span>
      </a>
      <nav class="space-y-1">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/prices" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/quotes" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/rules" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-500/10 text-red-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
        <a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m-6-4a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          Settings
        </a>
        <a href="/dashboard/subscription" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
          Subscription
        </a>
      </nav>
    </aside>

    <main class="ml-64 p-8 relative z-10">
      <div class="max-w-6xl">
        <!-- Header -->
        <div class="flex justify-between items-center mb-8">
          <div>
            <h1 class="text-3xl font-bold">⚙️ Pricing Rules</h1>
            <p class="text-zinc-500">Configure how quotes are calculated</p>
          </div>
          <button onclick="openModal()" class="px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white rounded-xl font-medium text-sm flex items-center gap-2">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
            Add Rule
          </button>
        </div>

        <!-- Quick Stats Cards -->
        <div class="grid md:grid-cols-4 gap-4 mb-8">
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-4 hover:border-red-500/30 transition cursor-pointer group" onclick="filterByType('minimum')">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-red-500/20 flex items-center justify-center group-hover:scale-110 transition">
                <span class="text-xl">€</span>
              </div>
              <div>
                <div class="text-lg font-semibold text-red-400">Minimum</div>
                <div class="text-xs text-zinc-500" id="count-minimum">0 rules</div>
              </div>
            </div>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-4 hover:border-blue-500/30 transition cursor-pointer group" onclick="filterByType('buffer')">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-blue-500/20 flex items-center justify-center group-hover:scale-110 transition">
                <span class="text-xl">🛡️</span>
              </div>
              <div>
                <div class="text-lg font-semibold text-blue-400">Margins</div>
                <div class="text-xs text-zinc-500" id="count-buffer">0 rules</div>
              </div>
            </div>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-4 hover:border-emerald-500/30 transition cursor-pointer group" onclick="filterByType('discount')">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-emerald-500/20 flex items-center justify-center group-hover:scale-110 transition">
                <span class="text-xl">%</span>
              </div>
              <div>
                <div class="text-lg font-semibold text-emerald-400">Discounts</div>
                <div class="text-xs text-zinc-500" id="count-discount">0 rules</div>
              </div>
            </div>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-xl p-4 hover:border-purple-500/30 transition cursor-pointer group" onclick="filterByType('tax')">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-lg bg-purple-500/20 flex items-center justify-center group-hover:scale-110 transition">
                <span class="text-xl">📋</span>
              </div>
              <div>
                <div class="text-lg font-semibold text-purple-400">Tax</div>
                <div class="text-xs text-zinc-500" id="count-tax">0 rules</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Preset Templates -->
        <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6 mb-8">
          <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <span>🚀</span> Quick Templates
          </h3>
          <div class="flex flex-wrap gap-3">
            <button onclick="applyTemplate('standard-margin')" class="px-4 py-2 bg-blue-500/20 text-blue-400 rounded-lg text-sm hover:bg-blue-500/30 transition flex items-center gap-2">
              <span>🛡️</span> Standard Margin (20%)
            </button>
            <button onclick="applyTemplate('vat')" class="px-4 py-2 bg-purple-500/20 text-purple-400 rounded-lg text-sm hover:bg-purple-500/30 transition flex items-center gap-2">
              <span>📋</span> VAT (20%)
            </button>
            <button onclick="applyTemplate('bulk-discount')" class="px-4 py-2 bg-emerald-500/20 text-emerald-400 rounded-lg text-sm hover:bg-emerald-500/30 transition flex items-center gap-2">
              <span>📦</span> Bulk Discount (10%)
            </button>
            <button onclick="applyTemplate('minimum-floor')" class="px-4 py-2 bg-red-500/20 text-red-400 rounded-lg text-sm hover:bg-red-500/30 transition flex items-center gap-2">
              <span>€</span> Minimum €50 Floor
            </button>
            <button onclick="applyTemplate('holiday')" class="px-4 py-2 bg-amber-500/20 text-amber-400 rounded-lg text-sm hover:bg-amber-500/30 transition flex items-center gap-2">
              <span>🎄</span> Holiday Special (15%)
            </button>
            <button onclick="applyTemplate('new-customer')" class="px-4 py-2 bg-cyan-500/20 text-cyan-400 rounded-lg text-sm hover:bg-cyan-500/30 transition flex items-center gap-2">
              <span>👋</span> New Customer (5%)
            </button>
          </div>
        </div>

        <!-- Filter Tabs -->
        <div class="flex gap-2 mb-6">
          <button onclick="setFilter('all')" class="filter-tab px-4 py-2 rounded-lg text-sm font-medium bg-red-600 text-white" data-filter="all">All Rules</button>
          <button onclick="setFilter('active')" class="filter-tab px-4 py-2 rounded-lg text-sm font-medium bg-white/[0.05] text-zinc-400 hover:bg-white/[0.1]" data-filter="active">Active</button>
          <button onclick="setFilter('inactive')" class="filter-tab px-4 py-2 rounded-lg text-sm font-medium bg-white/[0.05] text-zinc-400 hover:bg-white/[0.1]" data-filter="inactive">Inactive</button>
        </div>

        <!-- Rules Grid -->
        <div id="rules-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
          <p class="text-zinc-500 text-center py-8 col-span-3">Loading rules...</p>
        </div>

        <!-- Price Impact Calculator -->
        <div class="bg-gradient-to-br from-[#0c0c12] to-[#141419] border border-white/[0.08] rounded-2xl p-6 mt-8">
          <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <span>🧮</span> Price Impact Calculator
          </h3>
          <p class="text-zinc-500 text-sm mb-6">See how your rules affect a sample quote</p>
          
          <div class="grid md:grid-cols-3 gap-6">
            <!-- Input -->
            <div class="space-y-4">
              <div>
                <label class="block text-sm text-zinc-400 mb-2">Base Price</label>
                <div class="relative">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500">€</span>
                  <input type="number" id="calc-base" value="1000" min="0" step="0.01" 
                    class="w-full pl-8 pr-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl focus:border-red-500 focus:outline-none transition"
                    oninput="calculateImpact()" />
                </div>
              </div>
              <div>
                <label class="block text-sm text-zinc-400 mb-2">Quantity</label>
                <input type="number" id="calc-qty" value="1" min="1" 
                  class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl focus:border-red-500 focus:outline-none transition"
                  oninput="calculateImpact()" />
              </div>
            </div>

            <!-- Before -->
            <div class="bg-white/[0.03] rounded-xl p-4 border border-white/[0.06]">
              <div class="text-sm text-zinc-500 mb-2">Without Rules</div>
              <div class="text-2xl font-bold text-zinc-400" id="calc-before">€1,000.00</div>
            </div>

            <!-- After -->
            <div class="bg-gradient-to-br from-red-500/10 to-rose-500/10 rounded-xl p-4 border border-red-500/30">
              <div class="text-sm text-red-400 mb-2">With Active Rules</div>
              <div class="text-3xl font-bold text-white" id="calc-after">€1,000.00</div>
              <div class="text-sm mt-2" id="calc-diff"></div>
            </div>
          </div>

          <!-- Rule Breakdown -->
          <div class="mt-6 pt-6 border-t border-white/[0.06]">
            <div class="text-sm text-zinc-500 mb-3">How rules are applied:</div>
            <div id="calc-breakdown" class="space-y-2">
              <div class="text-zinc-600 text-sm">No active rules</div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Add/Edit Rule Modal -->
    <dialog id="rule-modal" class="p-0 rounded-2xl bg-[#0c0c12] border border-white/[0.1] w-full max-w-lg backdrop:bg-black/60">
      <div class="p-6">
        <div class="flex justify-between items-center mb-6">
          <h3 class="text-xl font-bold" id="modal-title">Add Pricing Rule</h3>
          <button onclick="closeModal()" class="text-zinc-500 hover:text-white transition">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
          </button>
        </div>
        
        <form id="rule-form" class="space-y-5">
          <input type="hidden" name="userId" value={userId} />
          <input type="hidden" name="ruleId" id="rule-id" />
          
          <!-- Rule Type Selection -->
          <div>
            <label class="block text-sm text-zinc-400 mb-3">Rule Type</label>
            <div class="grid grid-cols-4 gap-2">
              <button type="button" onclick="selectType('minimum')" class="type-btn p-3 rounded-xl border bg-white/[0.03] border-white/[0.1] hover:border-red-500/50 transition text-center" data-type="minimum">
                <div class="text-xl mb-1">€</div>
                <div class="text-xs text-zinc-400">Min</div>
              </button>
              <button type="button" onclick="selectType('buffer')" class="type-btn p-3 rounded-xl border bg-white/[0.03] border-white/[0.1] hover:border-blue-500/50 transition text-center" data-type="buffer">
                <div class="text-xl mb-1">🛡️</div>
                <div class="text-xs text-zinc-400">Margin</div>
              </button>
              <button type="button" onclick="selectType('discount')" class="type-btn p-3 rounded-xl border bg-white/[0.03] border-white/[0.1] hover:border-emerald-500/50 transition text-center" data-type="discount">
                <div class="text-xl mb-1">%</div>
                <div class="text-xs text-zinc-400">Discount</div>
              </button>
              <button type="button" onclick="selectType('tax')" class="type-btn p-3 rounded-xl border bg-white/[0.03] border-white/[0.1] hover:border-purple-500/50 transition text-center" data-type="tax">
                <div class="text-xl mb-1">📋</div>
                <div class="text-xs text-zinc-400">Tax</div>
              </button>
            </div>
            <input type="hidden" name="type" id="rule-type" value="discount" />
          </div>

          <div>
            <label class="block text-sm text-zinc-400 mb-2">Rule Name</label>
            <input type="text" name="name" id="rule-name" required 
              class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl focus:border-red-500 focus:outline-none transition placeholder:text-zinc-600" 
              placeholder="e.g., Holiday Discount" />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm text-zinc-400 mb-2" id="value-label">Value (%)</label>
              <div class="relative">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500" id="value-prefix">%</span>
                <input type="number" name="value" id="rule-value" step="0.01" required 
                  class="w-full pl-8 pr-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl focus:border-red-500 focus:outline-none transition" 
                  placeholder="10" />
              </div>
            </div>
            <div>
              <label class="block text-sm text-zinc-400 mb-2">Priority</label>
              <input type="number" name="priority" id="rule-priority" value="0" 
                class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl focus:border-red-500 focus:outline-none transition" 
                placeholder="0" />
              <p class="text-xs text-zinc-600 mt-1">Higher runs first</p>
            </div>
          </div>

          <!-- Description -->
          <div>
            <label class="block text-sm text-zinc-400 mb-2">Description (optional)</label>
            <textarea name="description" id="rule-desc" rows="2"
              class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl focus:border-red-500 focus:outline-none transition placeholder:text-zinc-600"
              placeholder="When should this rule apply?"></textarea>
          </div>

          <!-- Active Toggle -->
          <div class="flex items-center justify-between p-4 bg-white/[0.03] rounded-xl border border-white/[0.06]">
            <div>
              <div class="font-medium">Enable Rule</div>
              <div class="text-sm text-zinc-500">Active rules affect quotes</div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="active" id="rule-active" class="sr-only peer" checked />
              <div class="w-11 h-6 bg-zinc-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-red-600"></div>
            </label>
          </div>

          <div class="flex gap-3 pt-2">
            <button type="button" onclick="closeModal()" class="flex-1 py-3 border border-white/[0.1] rounded-xl text-zinc-400 hover:bg-white/[0.05] transition">Cancel</button>
            <button type="submit" class="flex-1 py-3 bg-red-600 hover:bg-red-500 rounded-xl font-medium transition">Save Rule</button>
          </div>
        </form>
      </div>
    </dialog>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-4 right-4 px-6 py-3 rounded-xl hidden z-50"></div>

    <script define:vars={{ userId }}>
      let allRules = [];
      let currentFilter = 'all';

      // Template definitions
      const templates = {
        'standard-margin': { name: 'Standard Margin', type: 'buffer', value: 20, active: true },
        'vat': { name: 'VAT', type: 'tax', value: 20, active: true },
        'bulk-discount': { name: 'Bulk Discount', type: 'discount', value: 10, active: true },
        'minimum-floor': { name: 'Minimum Price', type: 'minimum', value: 50, active: true },
        'holiday': { name: 'Holiday Special', type: 'discount', value: 15, active: true },
        'new-customer': { name: 'New Customer Discount', type: 'discount', value: 5, active: true }
      };

      function showToast(message, success = true) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.className = `fixed bottom-4 right-4 px-6 py-3 rounded-xl z-50 ${success ? 'bg-emerald-600' : 'bg-red-600'} text-white shadow-lg`;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3000);
      }

      async function loadRules() {
        try {
          const res = await fetch(`/api/rules?userId=${userId}`);
          const data = await res.json();
          
          if (data.success) {
            allRules = data.rules || [];
            updateCounts();
            renderRules();
            calculateImpact();
          }
        } catch (e) {
          console.error('Failed to load rules:', e);
        }
      }

      function updateCounts() {
        const counts = { minimum: 0, buffer: 0, discount: 0, tax: 0 };
        allRules.forEach(r => {
          if (counts[r.type] !== undefined) counts[r.type]++;
        });
        
        document.getElementById('count-minimum').textContent = `${counts.minimum} rules`;
        document.getElementById('count-buffer').textContent = `${counts.buffer} rules`;
        document.getElementById('count-discount').textContent = `${counts.discount} rules`;
        document.getElementById('count-tax').textContent = `${counts.tax} rules`;
      }

      function getFilteredRules() {
        if (currentFilter === 'all') return allRules;
        if (currentFilter === 'active') return allRules.filter(r => r.active);
        return allRules.filter(r => !r.active);
      }

      function setFilter(filter) {
        currentFilter = filter;
        document.querySelectorAll('.filter-tab').forEach(btn => {
          if (btn.dataset.filter === filter) {
            btn.className = 'filter-tab px-4 py-2 rounded-lg text-sm font-medium bg-red-600 text-white';
          } else {
            btn.className = 'filter-tab px-4 py-2 rounded-lg text-sm font-medium bg-white/[0.05] text-zinc-400 hover:bg-white/[0.1]';
          }
        });
        renderRules();
      }

      function filterByType(type) {
        currentFilter = 'all';
        document.querySelectorAll('.filter-tab').forEach(btn => {
          btn.className = 'filter-tab px-4 py-2 rounded-lg text-sm font-medium bg-white/[0.05] text-zinc-400 hover:bg-white/[0.1]';
        });
        
        const filtered = allRules.filter(r => r.type === type);
        renderFilteredRules(filtered);
      }

      function renderFilteredRules(rules) {
        const container = document.getElementById('rules-grid');
        
        if (rules.length === 0) {
          container.innerHTML = `
            <div class="col-span-3 text-center py-12">
              <div class="text-5xl mb-4">⚙️</div>
              <p class="text-zinc-500 mb-4">No rules of this type</p>
              <button onclick="openModal()" class="px-6 py-3 bg-red-600 rounded-xl font-medium">+ Add Rule</button>
            </div>
          `;
          return;
        }

        container.innerHTML = rules.map(r => getRuleCard(r)).join('');
      }

      function renderRules() {
        const rules = getFilteredRules();
        const container = document.getElementById('rules-grid');
        
        if (rules.length === 0) {
          container.innerHTML = `
            <div class="col-span-3 text-center py-12">
              <div class="text-5xl mb-4">⚙️</div>
              <p class="text-zinc-500 mb-4">${currentFilter === 'all' ? 'No rules yet. Add your first rule!' : 'No ' + currentFilter + ' rules'}</p>
              ${currentFilter === 'all' ? '<button onclick="openModal()" class="px-6 py-3 bg-red-600 rounded-xl font-medium">+ Add Rule</button>' : ''}
            </div>
          `;
          return;
        }

        container.innerHTML = rules.map(r => getRuleCard(r)).join('');
      }

      function getRuleCard(r) {
        const typeColors = {
          minimum: { bg: 'bg-red-500/20', text: 'text-red-400', border: 'border-red-500/30' },
          buffer: { bg: 'bg-blue-500/20', text: 'text-blue-400', border: 'border-blue-500/30' },
          discount: { bg: 'bg-emerald-500/20', text: 'text-emerald-400', border: 'border-emerald-500/30' },
          tax: { bg: 'bg-purple-500/20', text: 'text-purple-400', border: 'border-purple-500/30' }
        };
        
        const colors = typeColors[r.type] || typeColors.discount;
        const typeLabels = { minimum: 'Minimum', buffer: 'Margin', discount: 'Discount', tax: 'Tax' };
        
        return `
          <div class="group p-5 bg-white/[0.03] border ${r.active ? colors.border : 'border-white/[0.06]'} rounded-2xl hover:border-white/[0.15] transition-all">
            <div class="flex justify-between items-start mb-4">
              <div class="flex-1">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-xs px-2 py-1 rounded-full ${colors.bg} ${colors.text} font-medium">${typeLabels[r.type]}</span>
                  ${r.priority ? `<span class="text-xs text-zinc-600">#${r.priority}</span>` : ''}
                </div>
                <h3 class="font-semibold text-lg ${r.active ? 'text-white' : 'text-zinc-500'}">${r.name}</h3>
                ${r.description ? `<p class="text-sm text-zinc-500 mt-1">${r.description}</p>` : ''}
              </div>
              <div class="text-right">
                <div class="text-3xl font-bold ${r.active ? colors.text : 'text-zinc-600'}">
                  ${r.type === 'minimum' ? '€' : ''}${r.value}${r.type !== 'minimum' ? '%' : ''}
                </div>
              </div>
            </div>
            
            <div class="flex items-center gap-3">
              <button onclick="toggleRule('${r._id}', ${!r.active})" 
                class="flex-1 py-2.5 text-sm rounded-lg font-medium transition flex items-center justify-center gap-2 ${r.active ? 'bg-emerald-500/20 text-emerald-400 hover:bg-emerald-500/30' : 'bg-zinc-700/50 text-zinc-500 hover:bg-zinc-700'}">
                ${r.active ? `
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                  Active
                ` : `
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  Disabled
                `}
              </button>
              
              <button onclick="editRule('${r._id}')" class="px-3 py-2.5 text-sm rounded-lg bg-white/[0.05] text-zinc-400 hover:bg-white/[0.1] hover:text-white transition">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
              </button>
              
              <button onclick="deleteRule('${r._id}')" class="px-3 py-2.5 text-sm rounded-lg bg-white/[0.05] text-zinc-400 hover:bg-red-500/20 hover:text-red-400 transition">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
              </button>
            </div>
          </div>
        `;
      }

      function openModal(isEdit = false) {
        const modal = document.getElementById('rule-modal');
        
        if (!isEdit) {
          document.getElementById('modal-title').textContent = 'Add Pricing Rule';
          document.getElementById('rule-id').value = '';
          document.getElementById('rule-form').reset();
          document.getElementById('rule-active').checked = true;
          selectType('discount');
        }
        
        modal.showModal();
      }

      function closeModal() {
        document.getElementById('rule-modal').close();
      }

      function selectType(type) {
        document.getElementById('rule-type').value = type;
        
        const typeLabels = { minimum: 'Value (€)', buffer: 'Value (%)', discount: 'Value (%)', tax: 'Value (%)' };
        const typePrefixes = { minimum: '€', buffer: '%', discount: '%', tax: '%' };
        
        document.getElementById('value-label').textContent = typeLabels[type];
        document.getElementById('value-prefix').textContent = typePrefixes[type];
        
        document.querySelectorAll('.type-btn').forEach(btn => {
          if (btn.dataset.type === type) {
            btn.className = `type-btn p-3 rounded-xl border ${
              type === 'minimum' ? 'bg-red-500/20 border-red-500/50' :
              type === 'buffer' ? 'bg-blue-500/20 border-blue-500/50' :
              type === 'discount' ? 'bg-emerald-500/20 border-emerald-500/50' :
              'bg-purple-500/20 border-purple-500/50'
            } text-white transition text-center`;
          } else {
            btn.className = 'type-btn p-3 rounded-xl border bg-white/[0.03] border-white/[0.1] hover:border-white/[0.3] text-white transition text-center';
          }
        });
      }

      async function applyTemplate(templateKey) {
        const template = templates[templateKey];
        if (!template) return;
        
        document.getElementById('modal-title').textContent = 'Add Pricing Rule';
        document.getElementById('rule-id').value = '';
        document.getElementById('rule-name').value = template.name;
        document.getElementById('rule-value').value = template.value;
        document.getElementById('rule-active').checked = template.active;
        document.getElementById('rule-priority').value = 0;
        document.getElementById('rule-desc').value = '';
        
        selectType(template.type);
        
        const modal = document.getElementById('rule-modal');
        modal.showModal();
        
        showToast(`Template loaded: ${template.name}`);
      }

      function editRule(ruleId) {
        const rule = allRules.find(r => r._id === ruleId);
        if (!rule) return;
        
        document.getElementById('modal-title').textContent = 'Edit Pricing Rule';
        document.getElementById('rule-id').value = rule._id;
        document.getElementById('rule-name').value = rule.name;
        document.getElementById('rule-value').value = rule.value;
        document.getElementById('rule-active').checked = rule.active !== false;
        document.getElementById('rule-priority').value = rule.priority || 0;
        document.getElementById('rule-desc').value = rule.description || '';
        
        selectType(rule.type);
        
        const modal = document.getElementById('rule-modal');
        modal.showModal();
      }

      loadRules();

      document.getElementById('rule-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);
        
        const ruleId = formData.get('ruleId');
        const data = {
          userId: formData.get('userId'),
          name: formData.get('name'),
          type: formData.get('type'),
          value: parseFloat(formData.get('value')),
          priority: parseInt(formData.get('priority')) || 0,
          description: formData.get('description'),
          active: document.getElementById('rule-active').checked
        };
        
        try {
          let res;
          if (ruleId) {
            res = await fetch('/api/rules', {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ruleId, ...data })
            });
          } else {
            res = await fetch('/api/rules', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data)
            });
          }
          
          if (res.ok) {
            closeModal();
            loadRules();
            showToast(ruleId ? '✅ Rule updated!' : '✅ Rule added!');
          } else {
            showToast('❌ Failed to save rule', false);
          }
        } catch (err) {
          showToast('❌ Error: ' + err, false);
        }
      });

      async function toggleRule(id, active) {
        try {
          await fetch('/api/rules', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ruleId: id, userId, active })
          });
          loadRules();
          showToast(active ? '✅ Rule enabled' : 'Rule disabled');
        } catch (err) {
          showToast('❌ Failed to update', false);
        }
      }

      async function deleteRule(id) {
        if (confirm('Delete this rule?')) {
          try {
            await fetch('/api/rules', {
              method: 'DELETE',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ ruleId: id, userId })
            });
            loadRules();
            showToast('Rule deleted');
          } catch (err) {
            showToast('❌ Failed to delete', false);
          }
        }
      }

      function calculateImpact() {
        const base = parseFloat(document.getElementById('calc-base').value) || 0;
        const qty = parseInt(document.getElementById('calc-qty').value) || 1;
        const baseTotal = base * qty;
        
        const beforeEl = document.getElementById('calc-before');
        const afterEl = document.getElementById('calc-after');
        const diffEl = document.getElementById('calc-diff');
        const breakdownEl = document.getElementById('calc-breakdown');
        
        beforeEl.textContent = '€' + baseTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        
        const activeRules = allRules.filter(r => r.active).sort((a, b) => (b.priority || 0) - (a.priority || 0));
        
        if (activeRules.length === 0) {
          afterEl.textContent = '€' + baseTotal.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          diffEl.textContent = '';
          diffEl.className = 'text-sm mt-2';
          breakdownEl.innerHTML = '<div class="text-zinc-600 text-sm">No active rules</div>';
          return;
        }
        
        let price = baseTotal;
        const breakdown = [];
        
        const typeOrder = { minimum: 1, buffer: 2, discount: 3, tax: 4 };
        activeRules.sort((a, b) => {
          const pA = a.priority || 0;
          const pB = b.priority || 0;
          if (pA !== pB) return pB - pA;
          return typeOrder[a.type] - typeOrder[b.type];
        });
        
        for (const rule of activeRules) {
          const oldPrice = price;
          
          switch (rule.type) {
            case 'minimum':
              if (price < rule.value) {
                price = rule.value;
                breakdown.push({ name: rule.name, type: rule.type, from: oldPrice, to: price, change: price - oldPrice });
              }
              break;
            case 'buffer':
              price = price * (1 + rule.value / 100);
              breakdown.push({ name: rule.name, type: rule.type, from: oldPrice, to: price, change: rule.value + '%' });
              break;
            case 'discount':
              price = price * (1 - rule.value / 100);
              breakdown.push({ name: rule.name, type: rule.type, from: oldPrice, to: price, change: '-' + rule.value + '%' });
              break;
            case 'tax':
              price = price * (1 + rule.value / 100);
              breakdown.push({ name: rule.name, type: rule.type, from: oldPrice, to: price, change: '+' + rule.value + '%' });
              break;
          }
        }
        
        afterEl.textContent = '€' + price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        
        const diff = price - baseTotal;
        const diffPercent = ((diff / baseTotal) * 100).toFixed(1);
        
        if (diff > 0) {
          diffEl.textContent = `+€${diff.toFixed(2)} (+${diffPercent}%)`;
          diffEl.className = 'text-sm mt-2 text-emerald-400';
        } else if (diff < 0) {
          diffEl.textContent = `€${diff.toFixed(2)} (${diffPercent}%)`;
          diffEl.className = 'text-sm mt-2 text-red-400';
        } else {
          diffEl.textContent = 'No change';
          diffEl.className = 'text-sm mt-2 text-zinc-500';
        }
        
        if (breakdown.length === 0) {
          breakdownEl.innerHTML = '<div class="text-zinc-600 text-sm">Rules applied but no price change</div>';
        } else {
          breakdownEl.innerHTML = breakdown.map(item => {
            const colors = {
              minimum: 'text-red-400',
              buffer: 'text-blue-400',
              discount: 'text-emerald-400',
              tax: 'text-purple-400'
            };
            return `<div class="flex justify-between items-center text-sm"><span class="text-zinc-400">${item.name}</span><span class="${colors[item.type]}">${item.change}</span></div>`;
          }).join('');
        }
      }
    </script>
  </body>
</html>
