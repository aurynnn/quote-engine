---
import '../../styles/global.css';

const userId = '507f1f77bcf86cd799439011';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quotes - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <div class="fixed inset-0 -z-10 bg-gradient-to-br from-[#0a0a0f] via-[#0f0f14] to-[#0a0a0f]"></div>

    <aside class="fixed left-0 top-0 bottom-0 w-64 bg-[#0c0c12]/95 backdrop-blur-xl border-r border-white/[0.06] p-6 z-20">
      <a href="/" class="flex items-center gap-3 mb-8">
        <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-rose-600 rounded-lg"></div>
        <span class="text-xl font-semibold">Quote Engine</span>
      </a>
      <nav class="space-y-1">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/prices" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/quotes" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-500/10 text-red-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/rules" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
        <a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m-6-4a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          Settings
        </a>
      </nav>
    </aside>

    <main class="ml-64 p-8 relative z-10">
      <div class="max-w-6xl">
        <div class="flex justify-between items-center mb-8">
          <div>
            <h1 class="text-3xl font-bold">📄 Quotes</h1>
            <p class="text-zinc-500">All your generated quotes</p>
          </div>
          <a href="/dashboard" class="px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white rounded-xl font-medium text-sm">
            + New Quote
          </a>
        </div>

        <!-- Filters -->
        <div class="flex gap-3 mb-6">
          <button onclick="filterQuotes('all')" class="filter-btn active px-4 py-2 rounded-lg bg-white/[0.08] text-sm" data-filter="all">All</button>
          <button onclick="filterQuotes('draft')" class="filter-btn px-4 py-2 rounded-lg bg-white/[0.03] text-zinc-400 text-sm hover:bg-white/[0.08]" data-filter="draft">Draft</button>
          <button onclick="filterQuotes('sent')" class="filter-btn px-4 py-2 rounded-lg bg-white/[0.03] text-zinc-400 text-sm hover:bg-white/[0.08]" data-filter="sent">Sent</button>
          <button onclick="filterQuotes('accepted')" class="filter-btn px-4 py-2 rounded-lg bg-white/[0.03] text-zinc-400 text-sm hover:bg-white/[0.08]" data-filter="accepted">Accepted</button>
          <button onclick="filterQuotes('rejected')" class="filter-btn px-4 py-2 rounded-lg bg-white/[0.03] text-zinc-400 text-sm hover:bg-white/[0.08]" data-filter="rejected">Rejected</button>
        </div>

        <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
          <div id="quotes-list" class="space-y-3">
            <p class="text-zinc-500 text-center py-8">Loading quotes...</p>
          </div>
        </div>
      </div>
    </main>

    <script define:vars={{ userId }}>
      let allQuotes = [];

      async function loadQuotes() {
        try {
          const res = await fetch(`/api/quotes?id&userId=${userId}`);
          const data = await res.json();
          
          allQuotes = data.quotes || [];
          renderQuotes(allQuotes);
        } catch (e) {
          console.error('Failed to load quotes:', e);
        }
      }
      
      function renderQuotes(quotes) {
        const container = document.getElementById('quotes-list');
        
        if (quotes && quotes.length > 0) {
          container.innerHTML = quotes.map(q => `
            <div class="flex items-center justify-between p-5 rounded-xl bg-white/[0.02] hover:bg-white/[0.04] transition cursor-pointer border border-transparent hover:border-white/[0.06]" onclick="window.location.href='/dashboard/quote/${q._id}'">
              <div class="flex-1">
                <div class="font-semibold text-lg">${q.clientName}</div>
                <div class="text-sm text-zinc-500 mt-1">
                  <span class="font-mono">${q.quoteNumber}</span> • ${new Date(q.generatedAt).toLocaleDateString()} • ${q.items.length} items
                </div>
              </div>
              <div class="flex items-center gap-6">
                <span class="px-3 py-1.5 rounded-full text-xs font-medium ${
                  q.status === 'draft' ? 'bg-zinc-700/50 text-zinc-300' :
                  q.status === 'sent' ? 'bg-blue-500/20 text-blue-400' :
                  q.status === 'accepted' ? 'bg-emerald-500/20 text-emerald-400' :
                  'bg-red-500/20 text-red-400'
                }">${q.status}</span>
                <div class="text-right min-w-[100px]">
                  <div class="font-bold text-xl text-red-400">€${q.total.toFixed(2)}</div>
                </div>
              </div>
            </div>
          `).join('');
        } else {
          container.innerHTML = '<p class="text-zinc-500 text-center py-8">No quotes yet. Generate your first quote!</p>';
        }
      }

      function filterQuotes(status) {
        // Update buttons
        document.querySelectorAll('.filter-btn').forEach(btn => {
          if (btn.dataset.filter === status) {
            btn.className = 'filter-btn active px-4 py-2 rounded-lg bg-white/[0.08] text-sm';
          } else {
            btn.className = 'filter-btn px-4 py-2 rounded-lg bg-white/[0.03] text-zinc-400 text-sm hover:bg-white/[0.08]';
          }
        });

        if (status === 'all') {
          renderQuotes(allQuotes);
        } else {
          renderQuotes(allQuotes.filter(q => q.status === status));
        }
      }
      
      loadQuotes();
    </script>
  </body>
</html>
