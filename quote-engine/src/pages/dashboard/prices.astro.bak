---
import '../../styles/global.css';

const userId = '507f1f77bcf86cd799439011';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Prices - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <div class="fixed inset-0 -z-10 bg-gradient-to-br from-[#0a0a0f] via-[#0f0f14] to-[#0a0a0f]"></div>
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-emerald-500/5 rounded-full blur-[100px]"></div>
      <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] bg-cyan-500/5 rounded-full blur-[80px]"></div>
    </div>

    <aside class="fixed left-0 top-0 bottom-0 w-64 bg-[#0c0c12]/95 backdrop-blur-xl border-r border-white/[0.06] p-6 z-20">
      <a href="/" class="flex items-center gap-3 mb-8">
        <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-rose-600 rounded-lg"></div>
        <span class="text-xl font-semibold">Quote Engine</span>
      </a>
      <nav class="space-y-1">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/prices" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-500/10 text-red-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/quotes" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/rules" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
        <a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m-6-4a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          Settings
        </a>
      </nav>
      <a href="/dashboard/subscription" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition mt-2">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>
        Subscription
      </a>
    </aside>

    <main class="ml-64 p-8 relative z-10">
      <div class="max-w-6xl">
        <div class="flex items-center justify-between mb-8">
          <div>
            <h1 class="text-3xl font-bold">
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-400 to-blue-400">💰 Pricing Data</span>
            </h1>
            <p class="text-zinc-500">Manage your pricing items</p>
          </div>
          <div class="flex gap-3">
            <button id="sample-data-btn" class="group relative px-4 py-2.5 bg-white/[0.05] border border-white/[0.1] hover:border-emerald-500/30 text-zinc-300 hover:text-white rounded-xl font-medium text-sm transition-all">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>
                Sample Data
              </span>
            </button>
            <button onclick="openAddModal()" class="group relative px-5 py-2.5 bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-white rounded-xl font-medium text-sm transition-all shadow-lg shadow-emerald-600/20 hover:shadow-emerald-600/40 hover:scale-105">
              <span class="flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                Add Manually
              </span>
            </button>
          </div>
        </div>

        <!-- Drag & Drop Upload Zone -->
        <div class="mb-8">
          <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400">📥 Import Prices</span>
          </h3>
          
          <!-- Drop Zone -->
          <div id="drop-zone" class="group relative bg-white/[0.03] border-2 border-dashed border-white/[0.1] hover:border-emerald-500/40 rounded-2xl p-8 transition-all cursor-pointer">
            <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-2xl"></div>
            
            <div class="relative flex flex-col items-center text-center">
              <div id="drop-icon" class="w-16 h-16 mb-4 rounded-2xl bg-white/[0.05] flex items-center justify-center group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 text-zinc-500 group-hover:text-emerald-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                </svg>
              </div>
              <p class="text-lg font-medium text-zinc-300 mb-2">Drag & drop your Excel file here</p>
              <p class="text-sm text-zinc-500 mb-4">or click to browse • Supports .xlsx, .xls</p>
              <input type="file" id="file-input" accept=".xlsx,.xls" class="hidden" />
              <button type="button" onclick="document.getElementById('file-input').click()" class="px-5 py-2.5 bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] rounded-xl text-sm font-medium transition-all">
                Choose File
              </button>
            </div>
          </div>

          <!-- Upload Progress / Status -->
          <div id="upload-status" class="hidden mt-4"></div>

          <!-- Data Preview Section -->
          <div id="preview-section" class="hidden mt-6">
            <div class="flex items-center justify-between mb-4">
              <h4 class="text-md font-semibold flex items-center gap-2">
                <svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
                <span class="text-cyan-400">Preview</span>
                <span id="preview-count" class="text-xs text-zinc-500 font-normal"></span>
              </h4>
              <div class="flex gap-2">
                <button id="cancel-import" class="px-4 py-2 text-sm text-zinc-400 hover:text-white transition">Cancel</button>
                <button id="confirm-import" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 rounded-lg text-sm font-medium transition">
                  Import All
                </button>
              </div>
            </div>
            <div class="bg-white/[0.03] border border-white/[0.08] rounded-xl overflow-hidden max-h-64 overflow-y-auto">
              <table class="w-full text-sm">
                <thead class="bg-white/[0.03] sticky top-0">
                  <tr class="border-b border-white/[0.06]">
                    <th class="text-left py-2 px-4 text-zinc-400 font-medium">Category</th>
                    <th class="text-left py-2 px-4 text-zinc-400 font-medium">Name</th>
                    <th class="text-left py-2 px-4 text-zinc-400 font-medium">Unit</th>
                    <th class="text-right py-2 px-4 text-zinc-400 font-medium">Base Price</th>
                    <th class="text-right py-2 px-4 text-zinc-400 font-medium">Min Price</th>
                  </tr>
                </thead>
                <tbody id="preview-table-body">
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Prices Table -->
        <div class="group relative bg-white/[0.03] border border-white/[0.08] rounded-2xl p-6 overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-br from-blue-500/3 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
          <div class="relative">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-lg font-semibold">
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-400">📋 All Price Items</span>
              </h3>
              <div class="flex items-center gap-3">
                <span id="price-count" class="text-zinc-500">Loading...</span>
                <button id="refresh-btn" class="p-2 hover:bg-white/[0.05] rounded-lg transition" title="Refresh">
                  <svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                </button>
              </div>
            </div>
            <div id="prices-table" class="overflow-x-auto min-h-[200px] flex items-center justify-center">
              <div class="flex flex-col items-center py-8">
                <div class="w-8 h-8 border-2 border-zinc-600 border-t-cyan-400 rounded-full animate-spin mb-3"></div>
                <p class="text-zinc-500">Loading prices...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Add/Edit Modal -->
    <dialog id="add-modal" class="p-8 rounded-2xl bg-[#0c0c12] border border-white/[0.1] w-full max-w-lg">
      <h3 id="modal-title" class="text-xl font-bold mb-4">Add Price Item</h3>
      <form id="price-form" class="space-y-4">
        <input type="hidden" name="userId" value={userId} />
        <input type="hidden" name="itemId" id="item-id" />
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-zinc-400 mb-2">Category</label>
            <input type="text" name="category" id="category" required class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl text-white placeholder-zinc-600" placeholder="Development" />
          </div>
          <div>
            <label class="block text-sm text-zinc-400 mb-2">Name</label>
            <input type="text" name="name" id="name" required class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl text-white placeholder-zinc-600" placeholder="Website" />
          </div>
        </div>
        <div class="grid grid-cols-3 gap-4">
          <div>
            <label class="block text-sm text-zinc-400 mb-2">Unit</label>
            <input type="text" name="unit" id="unit" value="hour" class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl text-white" />
          </div>
          <div>
            <label class="block text-sm text-zinc-400 mb-2">Base Price (€)</label>
            <input type="number" name="basePrice" id="basePrice" step="0.01" required class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl text-white" />
          </div>
          <div>
            <label class="block text-sm text-zinc-400 mb-2">Min Price (€)</label>
            <input type="number" name="minPrice" id="minPrice" step="0.01" required class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl text-white" />
          </div>
        </div>
        <div class="flex gap-3 pt-2">
          <button type="button" onclick="closeModal()" class="flex-1 py-3 border border-white/[0.1] rounded-xl text-zinc-400 hover:text-white hover:border-white/20 transition">Cancel</button>
          <button type="submit" id="modal-submit" class="flex-1 py-3 bg-gradient-to-r from-emerald-500 to-cyan-500 rounded-xl font-medium">Add Item</button>
        </div>
      </form>
    </dialog>

    <script define:vars={{ userId }}>
      let previewData = [];
      let prices = [];

      // Initialize
      document.addEventListener('DOMContentLoaded', () => {
        loadPrices();
        setupDropZone();
      });

      // Drop Zone Setup
      function setupDropZone() {
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('file-input');

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
          dropZone.addEventListener(eventName, preventDefaults);
        });

        function preventDefaults(e) {
          e.preventDefault();
          e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
          dropZone.addEventListener(eventName, () => {
            dropZone.classList.add('border-emerald-500/40', 'bg-emerald-500/5');
          });
        });

        ['dragleave', 'drop'].forEach(eventName => {
          dropZone.addEventListener(eventName, () => {
            dropZone.classList.remove('border-emerald-500/40', 'bg-emerald-500/5');
          });
        });

        dropZone.addEventListener('drop', (e) => {
          const files = e.dataTransfer.files;
          if (files.length) handleFile(files[0]);
        });

        fileInput.addEventListener('change', (e) => {
          if (e.target.files.length) handleFile(e.target.files[0]);
        });

        document.getElementById('cancel-import').addEventListener('click', () => {
          document.getElementById('preview-section').classList.add('hidden');
          previewData = [];
          fileInput.value = '';
        });

        document.getElementById('confirm-import').addEventListener('click', importPreviewData);
        document.getElementById('refresh-btn').addEventListener('click', loadPrices);
        document.getElementById('sample-data-btn').addEventListener('click', loadSampleData);
      }

      // Handle file selection
      async function handleFile(file) {
        if (!file.name.match(/\.(xlsx|xls)$/i)) {
          showStatus('❌ Please select an Excel file (.xlsx or .xls)', 'error');
          return;
        }

        showStatus('⏳ Parsing file...', 'loading');

        const formData = new FormData();
        formData.append('file', file);
        formData.append('userId', userId);

        try {
          const res = await fetch('/api/prices/parse', { method: 'POST', body: formData });
          const data = await res.json();

          if (data.success && data.items?.length > 0) {
            previewData = data.items;
            showPreview(data.items);
            showStatus(`✅ Found ${data.items.length} items ready to import`, 'success');
          } else {
            showStatus('❌ No valid pricing data found in file', 'error');
          }
        } catch (err) {
          showStatus('❌ Error parsing file: ' + err.message, 'error');
        }
      }

      // Show preview table
      function showPreview(items) {
        const tbody = document.getElementById('preview-table-body');
        document.getElementById('preview-count').textContent = `(${items.length} items)`;
        
        tbody.innerHTML = items.map((item, i) => `
          <tr class="border-b border-white/[0.04] hover:bg-white/[0.02]">
            <td class="py-2 px-4"><span class="px-2 py-0.5 rounded-md bg-red-500/10 text-red-400 text-xs">${item.category || '-'}</span></td>
            <td class="py-2 px-4 font-medium">${item.name || '-'}</td>
            <td class="py-2 px-4 text-zinc-500">${item.unit || 'hour'}</td>
            <td class="py-2 px-4 text-right text-emerald-400">€${parseFloat(item.basePrice || 0).toFixed(2)}</td>
            <td class="py-2 px-4 text-right text-zinc-500">€${parseFloat(item.minPrice || 0).toFixed(2)}</td>
          </tr>
        `).join('');

        document.getElementById('preview-section').classList.remove('hidden');
      }

      // Import preview data
      async function importPreviewData() {
        const btn = document.getElementById('confirm-import');
        btn.disabled = true;
        btn.textContent = 'Importing...';

        try {
          const res = await fetch('/api/prices', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId, items: previewData })
          });

          const data = await res.json();
          
          if (data.success) {
            showStatus(`✅ Successfully imported ${previewData.length} items!`, 'success');
            document.getElementById('preview-section').classList.add('hidden');
            previewData = [];
            document.getElementById('file-input').value = '';
            loadPrices();
          } else {
            showStatus('❌ ' + (data.error || 'Import failed'), 'error');
          }
        } catch (err) {
          showStatus('❌ Error: ' + err.message, 'error');
        }

        btn.disabled = false;
        btn.textContent = 'Import All';
      }

      // Show status message
      function showStatus(message, type) {
        const status = document.getElementById('upload-status');
        status.classList.remove('hidden');
        
        const colors = {
          success: 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400',
          error: 'bg-red-500/10 border-red-500/20 text-red-400',
          loading: 'bg-white/[0.05] border-white/[0.1] text-zinc-400'
        };
        
        status.className = 'mt-4 p-4 rounded-xl border ' + colors[type];
        status.textContent = message;
      }

      // Load prices from API
      async function loadPrices() {
        const table = document.getElementById('prices-table');
        
        try {
          const res = await fetch('/api/prices?userId=' + userId);
          const data = await res.json();
          
          prices = data.items || [];
          document.getElementById('price-count').textContent = prices.length + ' items';
          
          if (prices.length > 0) {
            renderPricesTable(prices);
          } else {
            table.innerHTML = '<div class="flex flex-col items-center py-12 text-center"><div class="w-16 h-16 mb-4 rounded-2xl bg-white/[0.03] flex items-center justify-center"><svg class="w-8 h-8 text-zinc-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg></div><p class="text-zinc-500 mb-2">No pricing data yet</p><p class="text-zinc-600 text-sm">Upload an Excel file or add items manually</p></div>';
          }
        } catch (e) {
          console.error('Failed to load prices:', e);
          table.innerHTML = '<div class="flex flex-col items-center py-12"><p class="text-red-400 mb-2">Failed to load prices</p><button onclick="loadPrices()" class="text-sm text-cyan-400 hover:underline">Try again</button></div>';
        }
      }

      // Render prices table
      function renderPricesTable(items) {
        const table = document.getElementById('prices-table');
        
        table.innerHTML = '<table class="w-full"><thead><tr class="border-b border-white/[0.06]"><th class="text-left py-3 px-4 text-zinc-400 font-medium text-sm">Category</th><th class="text-left py-3 px-4 text-zinc-400 font-medium text-sm">Name</th><th class="text-left py-3 px-4 text-zinc-400 font-medium text-sm">Unit</th><th class="text-right py-3 px-4 text-zinc-400 font-medium text-sm">Base Price</th><th class="text-right py-3 px-4 text-zinc-400 font-medium text-sm">Min Price</th><th class="text-right py-3 px-4 text-zinc-400 font-medium text-sm">Actions</th></tr></thead><tbody>' +
