---
import '../../styles/global.css';

const userId = '67fc9ba0000000000000001';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Settings - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen">
    <aside class="sidebar fixed left-0 top-0 bottom-0 w-64 p-6">
      <a href="/" class="text-2xl font-bold gradient-text mb-8 block">Quote Engine</a>
      <nav class="space-y-1">
        <a href="/dashboard" class="sidebar-link">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/prices" class="sidebar-link">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/quotes" class="sidebar-link">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/rules" class="sidebar-link">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
      </nav>
    </aside>

    <main class="ml-64 p-8">
      <div class="max-w-2xl">
        <h1 class="text-3xl font-bold mb-8">⚙️ Settings</h1>

        <!-- Profile -->
        <div class="card p-6 mb-6">
          <h2 class="text-lg font-semibold mb-4">Profile</h2>
          <form id="profile-form" class="space-y-4">
            <div>
              <label class="block text-sm text-zinc-400 mb-2">Name</label>
              <input type="text" name="name" class="input" placeholder="Your name" />
            </div>
            <div>
              <label class="block text-sm text-zinc-400 mb-2">Company</label>
              <input type="text" name="company" class="input" placeholder="Your company" />
            </div>
            <div>
              <label class="block text-sm text-zinc-400 mb-2">Email</label>
              <input type="email" name="email" class="input" placeholder="you@example.com" disabled />
            </div>
            <button type="submit" class="btn-primary">Save Changes</button>
          </form>
        </div>

        <!-- Appearance -->
        <div class="card p-6 mb-6">
          <h2 class="text-lg font-semibold mb-4">Appearance</h2>
          <div class="flex items-center justify-between">
            <div>
              <div class="font-medium">Dark Mode</div>
              <div class="text-sm text-zinc-500">Use dark theme</div>
            </div>
            <button id="theme-toggle" class="w-14 h-8 rounded-full bg-zinc-700 relative transition-colors">
              <div class="w-6 h-6 rounded-full bg-white absolute top-1 left-1 transition-transform"></div>
            </button>
          </div>
        </div>

        <!-- Danger Zone -->
        <div class="card p-6 border-red-500/20">
          <h2 class="text-lg font-semibold mb-4 text-red-400">Danger Zone</h2>
          <p class="text-zinc-500 mb-4">Once you delete your account, there is no going back.</p>
          <button class="px-4 py-2 bg-red-500/20 text-red-400 rounded-lg hover:bg-red-500/30 transition-colors">
            Delete Account
          </button>
        </div>
      </div>
    </main>

    <script>
      // Theme toggle
      const themeBtn = document.getElementById('theme-toggle');
      const isDark = document.documentElement.classList.contains('dark');
      
      if (isDark) {
        themeBtn.classList.add('bg-emerald-500');
        themeBtn.querySelector('div').classList.add('translate-x-6');
      }
      
      themeBtn.addEventListener('click', () => {
        themeBtn.classList.toggle('bg-emerald-500');
        themeBtn.querySelector('div').classList.toggle('translate-x-6');
      });
    </script>
  </body>
</html>
