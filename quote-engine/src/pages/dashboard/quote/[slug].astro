---
import '../../../styles/global.css';

const userId = '507f1f77bcf86cd799439011';
const { slug } = Astro.params;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quote Details - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <div class="fixed inset-0 -z-10 bg-gradient-to-br from-[#0a0a0f] via-[#0f0f14] to-[#0a0a0f]"></div>

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 bottom-0 w-64 bg-[#0c0c12]/95 backdrop-blur-xl border-r border-white/[0.06] p-6 z-20">
      <a href="/" class="flex items-center gap-3 mb-8">
        <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-rose-600 rounded-lg"></div>
        <span class="text-xl font-semibold">Quote Engine</span>
      </a>
      <nav class="space-y-1">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/prices" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/quotes" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/rules" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
      </nav>
    </aside>

    <main class="ml-64 p-8 relative z-10">
      <div class="max-w-6xl">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
          <div>
            <a href="/dashboard/quotes" class="text-zinc-500 hover:text-white mb-2 inline-flex items-center gap-2">
              ← Back to Quotes
            </a>
            <h1 class="text-3xl font-bold" id="quote-title">Quote Details</h1>
            <div class="flex items-center gap-3 mt-2">
              <span id="status-badge" class="px-3 py-1 rounded-full text-xs font-medium bg-zinc-700 text-zinc-300">Draft</span>
              <span class="text-zinc-500 text-sm" id="quote-number">-</span>
            </div>
          </div>
          <div class="flex gap-3">
            <button onclick="openPDFPreview()" class="px-4 py-2 bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] rounded-xl flex items-center gap-2 transition">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
              Preview
            </button>
            <button onclick="downloadPDF()" class="px-4 py-2 bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] rounded-xl flex items-center gap-2 transition">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              Download
            </button>
            <button onclick="openSendModal()" class="px-4 py-2 bg-red-600 hover:bg-red-500 rounded-xl flex items-center gap-2 transition font-medium">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              Send to Client
            </button>
          </div>
        </div>

        <!-- Main Grid -->
        <div class="grid grid-cols-3 gap-6">
          <!-- Left Column -->
          <div class="col-span-2 space-y-6">
            <!-- Client Info Card -->
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold">Client Information</h2>
                <button onclick="toggleEditClient()" class="text-zinc-400 hover:text-white transition">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                </button>
              </div>
              <div id="client-view" class="grid grid-cols-2 gap-6">
                <div>
                  <div class="text-sm text-zinc-500 mb-1">Client Name</div>
                  <div class="text-xl font-semibold" id="client-name">Loading...</div>
                </div>
                <div class="text-right">
                  <div class="text-sm text-zinc-500 mb-1">Email</div>
                  <div class="text-zinc-300" id="client-email">-</div>
                </div>
              </div>
              <div id="client-edit" class="hidden grid grid-cols-2 gap-4">
                <input type="text" id="edit-client-name" placeholder="Client Name" class="bg-white/[0.05] border border-white/[0.1] rounded-lg px-4 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-red-500" />
                <input type="email" id="edit-client-email" placeholder="Client Email" class="bg-white/[0.05] border border-white/[0.1] rounded-lg px-4 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-red-500" />
                <button onclick="saveClient()" class="col-span-2 px-4 py-2 bg-red-600 hover:bg-red-500 rounded-lg font-medium">Save Changes</button>
              </div>
            </div>

            <!-- Line Items -->
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
              <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold">Line Items</h2>
                <button onclick="openAddItemModal()" class="px-3 py-1.5 bg-red-600 hover:bg-red-500 rounded-lg text-sm font-medium flex items-center gap-1 transition">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                  Add Item
                </button>
              </div>
              <table class="w-full">
                <thead>
                  <tr class="border-b border-white/[0.06]">
                    <th class="text-left py-3 text-zinc-400 font-medium text-sm">Item</th>
                    <th class="text-center py-3 text-zinc-400 font-medium text-sm w-20">Qty</th>
                    <th class="text-right py-3 text-zinc-400 font-medium text-sm w-32">Unit Price</th>
                    <th class="text-right py-3 text-zinc-400 font-medium text-sm w-32">Total</th>
                    <th class="w-20"></th>
                  </tr>
                </thead>
                <tbody id="items-table">
                  <tr><td colspan="5" class="py-8 text-center text-zinc-500">Loading...</td></tr>
                </tbody>
              </table>
            </div>

            <!-- Totals -->
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
              <div class="flex justify-end">
                <div class="w-72 space-y-3">
                  <div class="flex justify-between text-zinc-400">
                    <span>Subtotal</span>
                    <span id="subtotal">€0.00</span>
                  </div>
                  <div class="flex justify-between text-zinc-400" id="buffer-row">
                    <span>Buffer</span>
                    <span id="buffer">€0.00</span>
                  </div>
                  <div class="flex justify-between text-zinc-400" id="tax-row">
                    <span>Tax</span>
                    <span id="tax">€0.00</span>
                  </div>
                  <div class="flex justify-between text-xl font-bold pt-3 border-t border-white/[0.1]">
                    <span>Total</span>
                    <span class="text-red-400" id="total">€0.00</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column - Timeline & Actions -->
          <div class="space-y-6">
            <!-- Quote History -->
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
              <h2 class="text-lg font-semibold mb-4">Quote History</h2>
              <div class="space-y-4" id="timeline">
                <div class="text-center text-zinc-500 py-4">Loading timeline...</div>
              </div>
            </div>

            <!-- Update Status -->
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
              <h2 class="text-lg font-semibold mb-4">Update Status</h2>
              <div class="space-y-2">
                <button onclick="updateStatus('draft')" class="w-full px-4 py-2.5 bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] rounded-xl text-sm text-left flex items-center gap-3 transition">
                  <span class="w-2 h-2 rounded-full bg-zinc-500"></span> Draft
                </button>
                <button onclick="updateStatus('sent')" class="w-full px-4 py-2.5 bg-blue-600/10 hover:bg-blue-600/20 border border-blue-500/20 rounded-xl text-sm text-left flex items-center gap-3 transition">
                  <span class="w-2 h-2 rounded-full bg-blue-500"></span> Sent to Client
                </button>
                <button onclick="updateStatus('viewed')" class="w-full px-4 py-2.5 bg-purple-600/10 hover:bg-purple-600/20 border border-purple-500/20 rounded-xl text-sm text-left flex items-center gap-3 transition">
                  <span class="w-2 h-2 rounded-full bg-purple-500"></span> Viewed by Client
                </button>
                <button onclick="updateStatus('accepted')" class="w-full px-4 py-2.5 bg-emerald-600/10 hover:bg-emerald-600/20 border border-emerald-500/20 rounded-xl text-sm text-left flex items-center gap-3 transition">
                  <span class="w-2 h-2 rounded-full bg-emerald-500"></span> Accepted
                </button>
                <button onclick="updateStatus('rejected')" class="w-full px-4 py-2.5 bg-red-600/10 hover:bg-red-600/20 border border-red-500/20 rounded-xl text-sm text-left flex items-center gap-3 transition">
                  <span class="w-2 h-2 rounded-full bg-red-500"></span> Rejected
                </button>
              </div>
            </div>

            <!-- Quote Details -->
            <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
              <h2 class="text-lg font-semibold mb-4">Quote Details</h2>
              <div class="space-y-3 text-sm">
                <div class="flex justify-between"><span class="text-zinc-500">Created</span><span id="created-at">-</span></div>
                <div class="flex justify-between"><span class="text-zinc-500">Last Updated</span><span id="updated-at">-</span></div>
                <div class="flex justify-between"><span class="text-zinc-500">Valid Until</span><span id="valid-until">-</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-4 right-4 px-6 py-3 rounded-xl hidden z-50"></div>

    <!-- PDF Preview Modal -->
    <div id="pdf-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-8">
      <div class="bg-[#0c0c12] rounded-2xl w-full max-w-4xl h-[80vh] flex flex-col border border-white/[0.1]">
        <div class="flex items-center justify-between p-4 border-b border-white/[0.06<h3 class="]">
          text-lg font-semibold">PDF Preview</h3>
          <div class="flex items-center gap-2">
            <select id="template-select" onchange="updateTemplatePreview()" class="bg-white/[0.05] border border-white/[0.1] rounded-lg px-3 py-1.5 text-sm">
              <option value="modern">Modern</option>
              <option value="classic">Classic</option>
              <option value="minimal">Minimal</option>
              <option value="bold">Bold</option>
            </select>
            <button onclick="closePDFPreview()" class="text-zinc-400 hover:text-white p-1">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
            </button>
          </div>
        </div>
        <iframe id="pdf-preview-frame" class="flex-1 w-full bg-white" src=""></iframe>
        <div class="flex justify-end gap-3 p-4 border-t border-white/[0.06]">
          <button onclick="closePDFPreview()" class="px-4 py-2 bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] rounded-xl transition">Cancel</button>
          <button onclick="downloadPDF()" class="px-4 py-2 bg-red-600 hover:bg-red-500 rounded-xl transition font-medium">
            <span class="flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
              Download PDF
            </span>
          </button>
        </div>
      </div>
    </div>

    <!-- Add/Edit Item Modal -->
    <div id="item-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-8">
      <div class="bg-[#0c0c12] rounded-2xl w-full max-w-md border border-white/[0.1] p-6">
        <h3 class="text-lg font-semibold mb-4" id="item-modal-title">Add Line Item</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm text-zinc-400 mb-1">Item Name</label>
            <input type="text" id="item-name" class="w-full bg-white/[0.05] border border-white/[0.1] rounded-lg px-4 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-red-500" />
          </div>
          <div>
            <label class="block text-sm text-zinc-400 mb-1">Description</label>
            <textarea id="item-description" rows="2" class="w-full bg-white/[0.05] border border-white/[0.1] rounded-lg px-4 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-red-500"></textarea>
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm text-zinc-400 mb-1">Quantity</label>
              <input type="number" id="item-qty" value="1" min="1" class="w-full bg-white/[0.05] border border-white/[0.1] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-red-500" />
            </div>
            <div>
              <label class="block text-sm text-zinc-400 mb-1">Unit Price (€)</label>
              <input type="number" id="item-price" value="0" min="0" step="0.01" class="w-full bg-white/[0.05] border border-white/[0.1] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-red-500" />
            </div>
          </div>
        </div>
        <div class="flex justify-end gap-3 mt-6">
          <button onclick="closeItemModal()" class="px-4 py-2 bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] rounded-xl transition">Cancel</button>
          <button onclick="saveItem()" class="px-4 py-2 bg-red-600 hover:bg-red-500 rounded-xl transition font-medium">Save Item</button>
        </div>
      </div>
    </div>

    <!-- Send Quote Modal -->
    <div id="send-modal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-8">
      <div class="bg-[#0c0c12] rounded-2xl w-full max-w-md border border-white/[0.1] p-6">
        <h3 class="text-lg font-semibold mb-4">Send Quote to Client</h3>
        <div class="space-y-4">
          <div>
            <label class="block text-sm text-zinc-400 mb-1">Send to Email</label>
            <input type="email" id="send-email" class="w-full bg-white/[0.05] border border-white/[0.1] rounded-lg px-4 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-red-500" />
          </div>
          <div>
            <label class="block text-sm text-zinc-400 mb-1">Subject</label>
            <input type="text" id="send-subject" value="Your Quote from Quote Engine" class="w-full bg-white/[0.05] border border-white/[0.1] rounded-lg px-4 py-2 text-white focus:outline-none focus:border-red-500" />
          </div>
          <div>
            <label class="block text-sm text-zinc-400 mb-1">Message</label>
            <textarea id="send-message" rows="4" class="w-full bg-white/[0.05] border border-white/[0.1] rounded-lg px-4 py-2 text-white placeholder-zinc-500 focus:outline-none focus:border-red-500">Please find your quote attached. Let me know if you have any questions!</textarea>
          </div>
        </div>
        <div class="flex justify-end gap-3 mt-6">
          <button onclick="closeSendModal()" class="px-4 py-2 bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] rounded-xl transition">Cancel</button>
          <button onclick="confirmSend()" class="px-4 py-2 bg-red-600 hover:bg-red-500 rounded-xl transition font-medium flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            Send Quote
          </button>
        </div>
      </div>
    </div>

    <script define:vars={{ slug, userId }}>
      let currentQuote = null;
      let editingItemIndex = null;

      function showToast(message, success = true) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.className = `fixed bottom-4 right-4 px-6 py-3 rounded-xl ${success ? 'bg-emerald-600' : 'bg-red-600'} text-white z-50`;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3000);
      }

      async function loadQuote() {
        try {
          const res = await fetch(`/api/quotes/${slug}?userId=${userId}`);
          const data = await res.json();
          
          if (!data.quote) {
            document.getElementById('quote-title').textContent = 'Quote Not Found';
            return;
          }
          
          currentQuote = data.quote;
          const q = data.quote;
          
          // Header
          document.getElementById('quote-title').textContent = q.clientName || 'Quote Details';
          document.getElementById('quote-number').textContent = '#' + q.quoteNumber;
          
          // Status badge
          const statusBadge = document.getElementById('status-badge');
          const statusColors = {
            draft: 'bg-zinc-700 text-zinc-300',
            sent: 'bg-blue-600/30 text-blue-300',
            viewed: 'bg-purple-600/30 text-purple-300',
            accepted: 'bg-emerald-600/30 text-emerald-300',
            rejected: 'bg-red-600/30 text-red-300'
          };
          statusBadge.className = `px-3 py-1 rounded-full text-xs font-medium ${statusColors[q.status] || statusColors.draft}`;
          statusBadge.textContent = q.status ? q.status.charAt(0).toUpperCase() + q.status.slice(1) : 'Draft';
          
          // Client info
          document.getElementById('client-name').textContent = q.clientName || 'N/A';
          document.getElementById('client-email').textContent = q.clientEmail || '-';
          document.getElementById('edit-client-name').value = q.clientName || '';
          document.getElementById('edit-client-email').value = q.clientEmail || '';
          
          // Dates
          document.getElementById('created-at').textContent = new Date(q.generatedAt).toLocaleDateString();
          document.getElementById('updated-at').textContent = q.updatedAt ? new Date(q.updatedAt).toLocaleDateString() : '-';
          document.getElementById('valid-until').textContent = q.validUntil ? new Date(q.validUntil).toLocaleDateString() : '-';
          
          // Items
          renderItems(q.items || []);
          
          // Totals
          document.getElementById('subtotal').textContent = `€${(q.subtotal || 0).toFixed(2)}`;
          document.getElementById('buffer').textContent = `€${(q.buffer || 0).toFixed(2)}`;
          document.getElementById('tax').textContent = `€${(q.tax || 0).toFixed(2)}`;
          document.getElementById('total').textContent = `€${(q.total || 0).toFixed(2)}`;
          
          if (q.buffer === 0) document.getElementById('buffer-row').style.display = 'none';
          if (q.tax === 0) document.getElementById('tax-row').style.display = 'none';
          
          // Timeline
          renderTimeline(q);
          
          // Store for send modal
          document.getElementById('send-email').value = q.clientEmail || '';
          
        } catch (e) {
          console.error('Failed to load quote:', e);
        }
      }
      
      function renderItems(items) {
        const tbody = document.getElementById('items-table');
        if (!items || items.length === 0) {
          tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-zinc-500">No items yet. Click "Add Item" to add one.</td></tr>';
          return;
        }
        
        tbody.innerHTML = items.map((item, index) => `
          <tr class="border-b border-white/[0.04] hover:bg-white/[0.02]">
            <td class="py-3">
              <div class="font-medium">${item.name}</div>
              ${item.description ? `<div class="text-sm text-zinc-500">${item.description}</div>` : ''}
            </td>
            <td class="py-3 text-center">${item.quantity}</td>
            <td class="py-3 text-right">€${item.unitPrice.toFixed(2)}</td>
            <td class="py-3 text-right font-medium">€${item.total.toFixed(2)}</td>
            <td class="py-3 text-right">
              <div class="flex justify-end gap-2">
                <button onclick="editItem(${index})" class="text-zinc-400 hover:text-white p-1" title="Edit">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /></svg>
                </button>
                <button onclick="deleteItem(${index})" class="text-zinc-400 hover:text-red-400 p-1" title="Delete">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                </button>
              </div>
            </td>
          </tr>
        `).join('');
      }
      
      function renderTimeline(q) {
        const timeline = document.getElementById('timeline');
        const events = [];
        
        // Created
        events.push({ status: 'Quote Created', date: q.generatedAt, color: 'bg-zinc-500' });
        
        // Status-based events
        if (q.status === 'sent' || q.status === 'viewed' || q.status === 'accepted' || q.status === 'rejected') {
          events.push({ status: 'Sent to Client', date: q.sentAt || q.updatedAt, color: 'bg-blue-500' });
        }
        
        if (q.status === 'viewed' || q.status === 'accepted' || q.status === 'rejected') {
          events.push({ status: 'Viewed by Client', date: q.viewedAt || q.updatedAt, color: 'bg-purple-500' });
        }
        
        if (q.status === 'accepted') {
          events.push({ status: 'Accepted', date: q.acceptedAt || q.updatedAt, color: 'bg-emerald-500' });
        }
        
        if (q.status === 'rejected') {
          events.push({ status: 'Rejected', date: q.rejectedAt || q.updatedAt, color: 'bg-red-500' });
        }
        
        timeline.innerHTML = events.map((event, i) => {
          const isLast = i === events.length - 1;
          return `<div class="flex gap-3">
            <div class="flex flex-col items-center">
              <div class="w-3 h-3 rounded-full ${event.color}"></div>
              ${!isLast ? '<div class="w-0.5 flex-1 bg-white/[0.1]"></div>' : ''}
            </div>
            <div class="pb-4">
              <div class="font-medium text-sm">${event.status}</div>
              <div class="text-xs text-zinc-500">${new Date(event.date).toLocaleDateString()}</div>
            </div>
          </div>`;
        }).join('');
      }
      
      // Client edit functions
      function toggleEditClient() {
        document.getElementById('client-view').classList.toggle('hidden');
        document.getElementById('client-edit').classList.toggle('hidden');
      }
      
      async function saveClient() {
        const clientName = document.getElementById('edit-client-name').value;
        const clientEmail = document.getElementById('edit-client-email').value;
        
        try {
          const res = await fetch('/api/quotes/' + slug, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quoteId: slug, userId, clientName, clientEmail })
          });
          
          const data = await res.json();
          
          if (data.success) {
            showToast('✅ Client info updated!', true);
            toggleEditClient();
            loadQuote();
          } else {
            showToast('❌ ' + data.error, false);
          }
        } catch (err) {
          showToast('❌ Failed to update', false);
        }
      }
      
      // Item modal functions
      function openAddItemModal() {
        editingItemIndex = null;
        document.getElementById('item-modal-title').textContent = 'Add Line Item';
        document.getElementById('item-name').value = '';
        document.getElementById('item-description').value = '';
        document.getElementById('item-qty').value = '1';
        document.getElementById('item-price').value = '0';
        document.getElementById('item-modal').classList.remove('hidden');
      }
      
      function editItem(index) {
        const item = currentQuote.items[index];
        editingItemIndex = index;
        document.getElementById('item-modal-title').textContent = 'Edit Line Item';
        document.getElementById('item-name').value = item.name;
        document.getElementById('item-description').value = item.description || '';
        document.getElementById('item-qty').value = item.quantity;
        document.getElementById('item-price').value = item.unitPrice;
        document.getElementById('item-modal').classList.remove('hidden');
      }
      
      function closeItemModal() {
        document.getElementById('item-modal').classList.add('hidden');
        editingItemIndex = null;
      }
      
      async function saveItem() {
        const name = document.getElementById('item-name').value;
        const description = document.getElementById('item-description').value;
        const quantity = parseInt(document.getElementById('item-qty').value) || 1;
        const unitPrice = parseFloat(document.getElementById('item-price').value) || 0;
        const total = quantity * unitPrice;
        
        if (!name) {
          showToast('❌ Please enter item name', false);
          return;
        }
        
        let items = [...(currentQuote.items || [])];
        
        if (editingItemIndex !== null) {
          items[editingItemIndex] = { name, description, quantity, unitPrice, total };
        } else {
          items.push({ name, description, quantity, unitPrice, total });
        }
        
        try {
          const res = await fetch('/api/quotes/' + slug, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quoteId: slug, userId, items })
          });
          
          const data = await res.json();
          
          if (data.success) {
            showToast(editingItemIndex !== null ? '✅ Item updated!' : '✅ Item added!', true);
            closeItemModal();
            loadQuote();
          } else {
            showToast('❌ ' + data.error, false);
          }
        } catch (err) {
          showToast('❌ Failed to save item', false);
        }
      }
      
      async function deleteItem(index) {
        if (!confirm('Are you sure you want to delete this item?')) return;
        
        let items = [...(currentQuote.items || [])];
        items.splice(index, 1);
        
        try {
          const res = await fetch('/api/quotes/' + slug, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quoteId: slug, userId, items })
          });
          
          const data = await res.json();
          
          if (data.success) {
            showToast('✅ Item deleted!', true);
            loadQuote();
          } else {
            showToast('❌ ' + data.error, false);
          }
        } catch (err) {
          showToast('❌ Failed to delete item', false);
        }
      }
      
      // PDF functions
      function openPDFPreview() {
        const template = localStorage.getItem('quoteTemplate') || 'modern';
        document.getElementById('template-select').value = template;
        document.getElementById('pdf-preview-frame').src = `/api/quotes/${slug}/pdf?template=${template}&preview=true`;
        document.getElementById('pdf-modal').classList.remove('hidden');
      }
      
      function closePDFPreview() {
        document.getElementById('pdf-modal').classList.add('hidden');
      }
      
      function updateTemplatePreview() {
        const template = document.getElementById('template-select').value;
        localStorage.setItem('quoteTemplate', template);
        document.getElementById('pdf-preview-frame').src = `/api/quotes/${slug}/pdf?template=${template}&preview=true`;
      }
      
      function downloadPDF() {
        const template = localStorage.getItem('quoteTemplate') || 'modern';
        window.location.href = `/api/quotes/${slug}/pdf?template=${template}`;
      }
      
      // Send modal functions
      function openSendModal() {
        document.getElementById('send-email').value = currentQuote?.clientEmail || '';
        document.getElementById('send-modal').classList.remove('hidden');
      }
      
      function closeSendModal() {
        document.getElementById('send-modal').classList.add('hidden');
      }
      
      async function confirmSend() {
        const email = document.getElementById('send-email').value;
        const subject = document.getElementById('send-subject').value;
        const message = document.getElementById('send-message').value;
        
        if (!email) {
          showToast('❌ Please enter recipient email', false);
          return;
        }
        
        try {
          const res = await fetch('/api/quotes/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quoteId: slug, userId, email, subject, message })
          });
          
          const data = await res.json();
          
          if (data.success) {
            showToast('✅ Quote sent to client!', true);
            closeSendModal();
            loadQuote();
          } else {
            showToast('❌ ' + data.error, false);
          }
        } catch (err) {
          showToast('❌ Failed to send', false);
        }
      }
      
      // Status update
      async function updateStatus(status) {
        try {
          const res = await fetch('/api/quotes/' + slug, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ quoteId: slug, userId, status })
          });
          
          const data = await res.json();
          
          if (data.success) {
            showToast(`✅ Status updated to ${status}`, true);
            loadQuote();
          } else {
            showToast('❌ ' + data.error, false);
          }
        } catch (err) {
          showToast('❌ Failed to update', false);
        }
      }
      
      // Initialize
      loadQuote();
    </script>
  </body>
</html>
