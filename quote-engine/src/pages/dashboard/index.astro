---
import '../../styles/global.css';

const userId = '507f1f77bcf86cd799439011';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <!-- Clean background without stars -->
    <div class="fixed inset-0 -z-10 bg-gradient-to-br from-[#0a0a0f] via-[#0f0f14] to-[#0a0a0f]"></div>

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 bottom-0 w-64 bg-[#0c0c12]/95 backdrop-blur-xl border-r border-white/[0.06] p-6 z-20">
      <a href="/" class="flex items-center gap-3 mb-8">
        <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-rose-600 rounded-lg"></div>
        <span class="text-xl font-semibold">Quote Engine</span>
      </a>
      
      <nav class="space-y-1">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-500/10 text-red-400 font-medium">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/prices" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/quotes" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/rules" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
        <a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m-6-4a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          Settings
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="ml-64 p-8 relative z-10">
      <div class="max-w-6xl">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
          <div>
            <h1 class="text-3xl font-bold mb-1">Dashboard</h1>
            <p class="text-zinc-500">Manage your pricing and generate quotes</p>
          </div>
          <button onclick="document.getElementById('generate-modal').showModal()" class="group relative px-6 py-3 bg-red-600 hover:bg-red-500 text-white rounded-xl font-semibold transition-all shadow-lg shadow-red-600/20 hover:shadow-red-600/30">
            <span class="flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
              New Quote
            </span>
          </button>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 mb-8">
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 rounded-xl bg-red-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <span class="text-zinc-400 text-sm">Total Value</span>
            </div>
            <div class="text-3xl font-bold" id="total-value">€0</div>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 rounded-xl bg-blue-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              </div>
              <span class="text-zinc-400 text-sm">Quotes</span>
            </div>
            <div class="text-3xl font-bold" id="quote-count">0</div>
          </div>
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-10 h-10 rounded-xl bg-emerald-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <span class="text-zinc-400 text-sm">Accepted</span>
            </div>
            <div class="text-3xl font-bold" id="accepted-count">0</div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <!-- Generate Quote -->
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
            <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              Quick Quote
            </h3>
            <form id="quick-quote-form" class="space-y-4">
              <input type="hidden" name="userId" value={userId} />
              <input type="text" name="clientName" placeholder="Client name" required 
                class="w-full px-4 py-3 bg-white/[0.03] border border-white/[0.08] rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:border-red-500/50" />
              <textarea name="prompt" placeholder="Describe what you need..." rows="3" required 
                class="w-full px-4 py-3 bg-white/[0.03] border border-white/[0.08] rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:border-red-500/50"></textarea>
              <button type="submit" class="w-full py-3 bg-red-600 hover:bg-red-500 text-white rounded-xl font-medium transition-all shadow-lg shadow-red-600/20">
                Generate Quote
              </button>
            </form>
            <div id="quick-result" class="mt-4 hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20"></div>
          </div>

          <!-- Upload Prices -->
          <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
            <h3 class="text-lg font-semibold mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
              Upload Pricing
            </h3>
            <form id="upload-form" class="space-y-4">
              <input type="hidden" name="userId" value={userId} />
              <div class="border-2 border-dashed border-white/[0.1] rounded-xl p-8 text-center hover:border-red-500/30 transition-colors">
                <input type="file" name="file" accept=".xlsx,.xls" required 
                  class="hidden" id="file-input" />
                <label for="file-input" class="cursor-pointer">
                  <svg class="w-10 h-10 mx-auto mb-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" /></svg>
                  <p class="text-zinc-400">Drop Excel file or click to upload</p>
                </label>
              </div>
              <button type="submit" class="w-full py-3 bg-white/[0.08] hover:bg-white/[0.12] border border-white/[0.08] rounded-xl font-medium transition-all">
                Upload Prices
              </button>
            </form>
            <div id="upload-result" class="mt-4 hidden p-4 rounded-xl"></div>
          </div>
        </div>

        <!-- Recent Quotes -->
        <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold">Recent Quotes</h3>
            <a href="/dashboard/quotes" class="text-red-400 hover:text-red-300 text-sm">View All →</a>
          </div>
          <div id="recent-quotes" class="space-y-3">
            <p class="text-zinc-500 text-center py-8">No quotes yet. Generate your first quote!</p>
          </div>
        </div>
      </div>
    </main>

    <!-- Modal -->
    <dialog id="generate-modal" class="p-8 rounded-2xl bg-[#0c0c12] border border-white/[0.1] shadow-2xl">
      <h3 class="text-xl font-bold mb-4">Generate New Quote</h3>
      <form id="modal-quote-form" class="space-y-4">
        <input type="hidden" name="userId" value={userId} />
        <div>
          <label class="block text-sm text-zinc-400 mb-2">Client Name</label>
          <input type="text" name="clientName" required class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl" />
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-2">Client Email</label>
          <input type="email" name="clientEmail" class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl" />
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-2">What do you need?</label>
          <textarea name="prompt" rows="4" required class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl"></textarea>
        </div>
        <div class="flex gap-3">
          <button type="button" onclick="document.getElementById('generate-modal').close()" class="flex-1 py-3 border border-white/[0.1] rounded-xl text-zinc-400 hover:bg-white/[0.05]">Cancel</button>
          <button type="submit" class="flex-1 py-3 bg-red-600 rounded-xl font-medium">Generate</button>
        </div>
      </form>
    </dialog>

    <script define:vars={{ userId }}>
      async function loadStats() {
        try {
          const quotesRes = await fetch(`/api/quotes?id&userId=${userId}`);
          const quotes = await quotesRes.json();
          
          document.getElementById('quote-count').textContent = quotes.count || 0;
          
          // Calculate total value
          const accepted = quotes.quotes?.filter(q => q.status === 'accepted') || [];
          document.getElementById('accepted-count').textContent = accepted.length;
          
          const total = quotes.quotes?.reduce((sum, q) => sum + q.total, 0) || 0;
          document.getElementById('total-value').textContent = '€' + total.toFixed(0);
          
          // Recent quotes
          if (quotes.quotes && quotes.quotes.length > 0) {
            const container = document.getElementById('recent-quotes');
            container.innerHTML = quotes.quotes.slice(0, 5).map(q => `
              <div class="flex items-center justify-between p-4 rounded-xl bg-white/[0.02] hover:bg-white/[0.04] transition cursor-pointer" onclick="window.location.href='/dashboard/quote/${q._id}'">
                <div>
                  <div class="font-medium">${q.clientName}</div>
                  <div class="text-sm text-zinc-500">${q.quoteNumber} • ${new Date(q.generatedAt).toLocaleDateString()}</div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-red-400">€${q.total.toFixed(2)}</div>
                  <div class="text-xs px-2 py-0.5 rounded-full inline-block ${q.status === 'accepted' ? 'bg-emerald-500/20 text-emerald-400' : q.status === 'sent' ? 'bg-blue-500/20 text-blue-400' : 'bg-zinc-700 text-zinc-400'}">${q.status}</div>
                </div>
              </div>
            `).join('');
          }
        } catch (e) {
          console.error('Failed to load stats:', e);
        }
      }
      
      loadStats();

      // Quick quote form
      document.getElementById('quick-quote-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        await handleQuoteSubmit(e.target);
      });

      // Modal quote form
      document.getElementById('modal-quote-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        await handleQuoteSubmit(e.target);
        document.getElementById('generate-modal').close();
      });

      async function handleQuoteSubmit(form) {
        const formData = new FormData(form);
        const data = {
          userId: formData.get('userId'),
          clientName: formData.get('clientName'),
          clientEmail: formData.get('clientEmail') || '',
          prompt: formData.get('prompt')
        };
        
        const result = form.nextElementSibling;
        
        try {
          const res = await fetch('/api/quote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const response = await res.json();
          
          if (response.success) {
            result.classList.remove('hidden', 'bg-red-500/20');
            result.classList.add('bg-emerald-500/10', 'border-emerald-500/20');
            result.innerHTML = `<div class="font-medium text-emerald-400">✅ Quote ${response.quote.quoteNumber} - €${response.quote.total.toFixed(2)}</div><div class="text-sm text-zinc-400 mt-1">${response.quote.items.length} items generated</div>`;
            loadStats();
            form.reset();
          } else {
            result.classList.remove('hidden', 'bg-emerald-500/10');
            result.classList.add('bg-red-500/20');
            result.innerHTML = `<div class="text-red-400">${response.error}</div>`;
          }
        } catch (err) {
          result.classList.remove('hidden');
          result.innerHTML = `<div class="text-red-400">Error: ${err}</div>`;
        }
      }

      // Upload form
      document.getElementById('upload-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);
        const result = document.getElementById('upload-result');
        
        result.classList.remove('hidden');
        result.innerHTML = '<span class="text-zinc-400">Uploading...</span>';
        
        try {
          const res = await fetch('/api/prices', { method: 'POST', body: formData });
          const data = await res.json();
          
          if (data.success) {
            result.className = 'mt-4 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20';
            result.innerHTML = `✅ ${data.itemsCount} price items uploaded`;
          } else {
            result.className = 'mt-4 p-4 rounded-xl bg-red-500/10 border border-red-500/20';
            result.innerHTML = `❌ ${data.error}`;
          }
        } catch (err) {
          result.innerHTML = `❌ Error: ${err}`;
        }
      });
    </script>
  </body>
</html>
