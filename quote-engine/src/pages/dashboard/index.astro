---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <!-- Background like homepage -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[400px] bg-red-500/10 rounded-full blur-[100px]"></div>
      <div class="absolute inset-0" id="stars"></div>
    </div>

    <!-- Sidebar -->
    <aside class="fixed left-0 top-0 bottom-0 w-64 bg-[#0a0a0f]/80 backdrop-blur-xl border-r border-white/5 p-6 z-20">
      <a href="/" class="flex items-center gap-3 mb-8">
        <div class="w-8 h-8 bg-gradient-to-br from-red-400 to-rose-500 rounded-lg"></div>
        <span class="text-xl font-semibold">Quote Engine</span>
      </a>
      
      <nav class="space-y-1">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-500/10 text-red-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/prices" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/5 hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/quotes" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/5 hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/rules" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/5 hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="ml-64 p-8 relative z-10">
      <div class="max-w-6xl">
        <!-- Header -->
        <div class="flex items-center justify-between mb-8">
          <div>
            <h1 class="text-3xl font-bold mb-1">Dashboard</h1>
            <p class="text-zinc-500">Manage your pricing and generate quotes</p>
          </div>
          <button onclick="document.getElementById('generate-modal').showModal()" class="px-6 py-3 bg-gradient-to-r from-red-500 to-rose-500 hover:from-red-600 hover:to-rose-600 text-white rounded-xl font-semibold transition shadow-lg shadow-red-500/25">
            + New Quote
          </button>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 mb-8">
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
            <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-rose-400" id="price-count">-</div>
            <div class="text-zinc-500 mt-2">Price Items</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
            <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-rose-400" id="quote-count">-</div>
            <div class="text-zinc-500 mt-2">Quotes Generated</div>
          </div>
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
            <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-rose-400" id="rule-count">-</div>
            <div class="text-zinc-500 mt-2">Active Rules</div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="grid md:grid-cols-2 gap-6 mb-8">
          <!-- Upload -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
            <h3 class="text-lg font-semibold mb-4">📊 Upload Pricing Data</h3>
            <form id="upload-form" class="space-y-4">
              <input type="hidden" name="userId" value="67fc9ba0000000000000001" />
              <input type="file" name="file" accept=".xlsx,.xls" required 
                class="w-full p-4 rounded-xl bg-white/5 border border-white/10 text-white file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-red-500 file:text-white file:cursor-pointer" />
              <button type="submit" class="w-full py-3 bg-red-500 hover:bg-red-600 text-white rounded-xl font-medium transition">
                Upload & Process
              </button>
            </form>
            <div id="upload-result" class="mt-4 hidden p-4 rounded-lg bg-green-500/20"></div>
          </div>

          <!-- Generate -->
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
            <h3 class="text-lg font-semibold mb-4">✨ Quick Quote</h3>
            <form id="quote-form" class="space-y-4">
              <input type="hidden" name="userId" value="67fc9ba0000000000000001" />
              <input type="text" name="clientName" placeholder="Client Name" required class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:border-red-500" />
              <textarea name="prompt" placeholder="Describe what you need..." rows="3" required class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white placeholder-zinc-500 focus:outline-none focus:border-red-500"></textarea>
              <button type="submit" class="w-full py-3 bg-gradient-to-r from-red-500 to-rose-500 hover:from-red-600 hover:to-rose-600 text-white rounded-xl font-medium transition">
                Generate Quote
              </button>
            </form>
            <div id="quote-result" class="mt-4 hidden p-4 rounded-lg bg-white/10"></div>
          </div>
        </div>

        <!-- Recent Quotes -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold">Recent Quotes</h3>
            <a href="/dashboard/quotes" class="text-red-400 hover:text-red-300 text-sm">View All →</a>
          </div>
          <div id="recent-quotes" class="space-y-3">
            <p class="text-zinc-500 text-center py-8">No quotes yet. Generate your first quote!</p>
          </div>
        </div>
      </div>
    </main>

    <!-- Modal -->
    <dialog id="generate-modal" class="p-8 rounded-2xl bg-[#0a0a0f] border border-white/10">
      <h3 class="text-xl font-bold mb-4">Generate New Quote</h3>
      <form id="modal-quote-form" class="space-y-4">
        <input type="hidden" name="userId" value="67fc9ba0000000000000001" />
        <div>
          <label class="block text-sm text-zinc-400 mb-2">Client Name</label>
          <input type="text" name="clientName" required class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white" />
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-2">Client Email</label>
          <input type="email" name="clientEmail" class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white" />
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-2">What do you need?</label>
          <textarea name="prompt" rows="4" required class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl text-white" placeholder="Describe your project..."></textarea>
        </div>
        <div class="flex gap-3">
          <button type="button" onclick="document.getElementById('generate-modal').close()" class="flex-1 py-3 border border-white/10 rounded-xl text-zinc-400 hover:bg-white/5">Cancel</button>
          <button type="submit" class="flex-1 py-3 bg-red-500 text-white rounded-xl">Generate</button>
        </div>
      </form>
    </dialog>

    <!-- Stars -->
    <script>
      const stars = document.getElementById('stars');
      if (stars) {
        for (let i = 0; i < 50; i++) {
          const star = document.createElement('div');
          star.className = 'absolute w-1 h-1 bg-white rounded-full';
          star.style.left = Math.random() * 100 + '%';
          star.style.top = Math.random() * 100 + '%';
          star.style.opacity = Math.random() * 0.5 + 0.2;
          stars.appendChild(star);
        }
      }
    </script>

    <script>
      const userId = '67fc9ba0000000000000001';

      async function loadStats() {
        try {
          const pricesRes = await fetch(`/api/prices?userId=${userId}`);
          const prices = await pricesRes.json();
          document.getElementById('price-count').textContent = prices.count || 0;
          
          const quotesRes = await fetch(`/api/quotes?id&userId=${userId}`);
          const quotes = await quotesRes.json();
          document.getElementById('quote-count').textContent = quotes.count || 0;
          
          const rulesRes = await fetch(`/api/rules?userId=${userId}`);
          const rules = await rulesRes.json();
          document.getElementById('rule-count').textContent = rules.count || 0;
          
          if (quotes.quotes && quotes.quotes.length > 0) {
            const container = document.getElementById('recent-quotes');
            container.innerHTML = quotes.quotes.slice(0, 5).map(q => `
              <div class="flex items-center justify-between p-4 rounded-xl bg-white/5 hover:bg-white/10 transition">
                <div>
                  <div class="font-medium">${q.clientName}</div>
                  <div class="text-sm text-zinc-500">${q.quoteNumber} • ${new Date(q.generatedAt).toLocaleDateString()}</div>
                </div>
                <div class="text-right">
                  <div class="font-bold text-red-400">€${q.total.toFixed(2)}</div>
                  <div class="text-xs text-zinc-500 capitalize">${q.status}</div>
                </div>
              </div>
            `).join('');
          }
        } catch (e) {
          console.error('Failed to load stats:', e);
        }
      }
      
      loadStats();

      document.getElementById('upload-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const form = e.target;
        const formData = new FormData(form);
        const result = document.getElementById('upload-result');
        
        result.classList.remove('hidden');
        result.innerHTML = 'Uploading...';
        
        try {
          const res = await fetch('/api/prices', { method: 'POST', body: formData });
          const data = await res.json();
          
          if (data.success) {
            result.innerHTML = `✅ Success! ${data.itemsCount} price items uploaded.`;
            loadStats();
          } else {
            result.innerHTML = `❌ Error: ${data.error}`;
          }
        } catch (err) {
          result.innerHTML = `❌ Error: ${err}`;
        }
      });

      async function handleQuoteForm(form) {
        const formData = new FormData(form);
        const data = {
          userId: formData.get('userId'),
          clientName: formData.get('clientName'),
          clientEmail: formData.get('clientEmail') || '',
          prompt: formData.get('prompt')
        };
        
        const result = form.closest('form').nextElementSibling;
        
        try {
          const res = await fetch('/api/quote', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const response = await res.json();
          
          if (response.success) {
            result.classList.remove('hidden');
            result.innerHTML = `
              <div class="font-semibold text-green-400 mb-2">✅ Quote Generated!</div>
              <div class="text-sm">
                <div><strong>Quote #:</strong> ${response.quote.quoteNumber}</div>
                <div><strong>Total:</strong> €${response.quote.total.toFixed(2)}</div>
                <div class="mt-2 text-zinc-400">Items: ${response.quote.items.length}</div>
              </div>
            `;
            loadStats();
          } else {
            result.innerHTML = `❌ Error: ${response.error}`;
          }
        } catch (err) {
          result.innerHTML = `❌ Error: ${err}`;
        }
      }

      document.getElementById('quote-form').addEventListener('submit', (e) => {
        e.preventDefault();
        handleQuoteForm(e.target);
      });

      document.getElementById('modal-quote-form').addEventListener('submit', (e) => {
        e.preventDefault();
        handleQuoteForm(e.target);
        document.getElementById('generate-modal').close();
      });
    </script>
  </body>
</html>
