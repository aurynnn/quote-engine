---
import '../../styles/global.css';

const userId = '507f1f77bcf86cd799439011';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clients - Quote Engine</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <div class="fixed inset-0 -z-10 bg-gradient-to-br from-[#0a0a0f] via-[#0f0f14] to-[#0a0a0f]"></div>

    <aside class="fixed left-0 top-0 bottom-0 w-64 bg-[#0c0c12]/95 backdrop-blur-xl border-r border-white/[0.06] p-6 z-20">
      <a href="/" class="flex items-center gap-3 mb-8">
        <div class="w-8 h-8 bg-gradient-to-br from-red-500 to-rose-600 rounded-lg"></div>
        <span class="text-xl font-semibold">Quote Engine</span>
      </a>
      <nav class="space-y-1">
        <a href="/dashboard" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
          Dashboard
        </a>
        <a href="/dashboard/prices" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Prices
        </a>
        <a href="/dashboard/quotes" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Quotes
        </a>
        <a href="/dashboard/clients" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-red-500/10 text-red-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          Clients
        </a>
        <a href="/dashboard/rules" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          Rules
        </a>
        <a href="/dashboard/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl text-zinc-400 hover:bg-white/[0.04] hover:text-white transition">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m-6-4a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
          Settings
        </a>
      </nav>
    </aside>

    <main class="ml-64 p-8 relative z-10">
      <div class="max-w-6xl">
        <div class="flex justify-between items-center mb-8">
          <div>
            <h1 class="text-3xl font-bold">👥 Clients</h1>
            <p class="text-zinc-500">Manage your clients</p>
          </div>
          <button onclick="document.getElementById('add-client-modal').showModal()" class="px-5 py-2.5 bg-red-600 hover:bg-red-500 text-white rounded-xl font-medium text-sm">
            + Add Client
          </button>
        </div>

        <!-- Search -->
        <div class="mb-6">
          <input type="text" id="search" placeholder="Search clients..." 
            class="w-full max-w-md px-4 py-3 bg-white/[0.03] border border-white/[0.08] rounded-xl text-white placeholder-zinc-500"
            onkeyup="filterClients()" />
        </div>

        <div class="bg-white/[0.03] border border-white/[0.06] rounded-2xl p-6">
          <div id="clients-list" class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            <p class="text-zinc-500 text-center py-8 col-span-full">No clients yet. Add your first client!</p>
          </div>
        </div>
      </div>
    </main>

    <!-- Add Client Modal -->
    <dialog id="add-client-modal" class="p-8 rounded-2xl bg-[#0c0c12] border border-white/[0.1]">
      <h3 class="text-xl font-bold mb-4">Add New Client</h3>
      <form id="client-form" class="space-y-4">
        <input type="hidden" name="userId" value={userId} />
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm text-zinc-400 mb-2">Name</label>
            <input type="text" name="name" required class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl" />
          </div>
          <div>
            <label class="block text-sm text-zinc-400 mb-2">Company</label>
            <input type="text" name="company" class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl" />
          </div>
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-2">Email</label>
          <input type="email" name="email" required class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl" />
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-2">Phone</label>
          <input type="tel" name="phone" class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl" />
        </div>
        <div>
          <label class="block text-sm text-zinc-400 mb-2">Address</label>
          <textarea name="address" rows="2" class="w-full px-4 py-3 bg-white/[0.05] border border-white/[0.1] rounded-xl"></textarea>
        </div>
        <div class="flex gap-3">
          <button type="button" onclick="document.getElementById('add-client-modal').close()" class="flex-1 py-3 border border-white/[0.1] rounded-xl text-zinc-400 hover:bg-white/[0.05]">Cancel</button>
          <button type="submit" class="flex-1 py-3 bg-red-600 rounded-xl font-medium">Add Client</button>
        </div>
      </form>
    </dialog>

    <!-- Toast -->
    <div id="toast" class="fixed bottom-4 right-4 px-6 py-3 rounded-xl hidden"></div>

    <script define:vars={{ userId }}>
      let clients = [];

      function showToast(message, success = true) {
        const toast = document.getElementById('toast');
        toast.textContent = message;
        toast.className = `fixed bottom-4 right-4 px-6 py-3 rounded-xl ${success ? 'bg-emerald-600' : 'bg-red-600'} text-white`;
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 3000);
      }

      // Load clients from localStorage (for demo)
      function loadClients() {
        const stored = localStorage.getItem('quote_clients_' + userId);
        clients = stored ? JSON.parse(stored) : [];
        renderClients(clients);
      }

      function renderClients(list) {
        const container = document.getElementById('clients-list');
        
        if (list && list.length > 0) {
          container.innerHTML = list.map(c => `
            <div class="p-5 bg-white/[0.02] border border-white/[0.06] rounded-xl hover:border-red-500/30 transition cursor-pointer" onclick="editClient('${c.id}')">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-red-500 to-rose-600 flex items-center justify-center text-xl font-bold">
                  ${c.name.charAt(0).toUpperCase()}
                </div>
                <div class="flex-1 min-w-0">
                  <div class="font-semibold truncate">${c.name}</div>
                  <div class="text-sm text-zinc-500 truncate">${c.company || c.email}</div>
                </div>
              </div>
              <div class="mt-4 pt-4 border-t border-white/[0.06] flex justify-between text-sm text-zinc-500">
                <span>${c._quotes || 0} quotes</span>
                <button onclick="event.stopPropagation(); deleteClient('${c.id}')" class="text-red-400 hover:text-red-300">Delete</button>
              </div>
            </div>
          `).join('');
        } else {
          container.innerHTML = '<p class="text-zinc-500 text-center py-8 col-span-full">No clients yet. Add your first client!</p>';
        }
      }

      function filterClients() {
        const search = document.getElementById('search').value.toLowerCase();
        const filtered = clients.filter(c => 
          c.name.toLowerCase().includes(search) || 
          (c.company && c.company.toLowerCase().includes(search)) ||
          c.email.toLowerCase().includes(search)
        );
        renderClients(filtered);
      }

      document.getElementById('client-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(e.target);
        
        const client = {
          id: Date.now().toString(),
          name: formData.get('name'),
          company: formData.get('company'),
          email: formData.get('email'),
          phone: formData.get('phone'),
          address: formData.get('address'),
          createdAt: new Date().toISOString(),
          _quotes: 0
        };
        
        clients.push(client);
        localStorage.setItem('quote_clients_' + userId, JSON.stringify(clients));
        
        document.getElementById('add-client-modal').close();
        e.target.reset();
        renderClients(clients);
        showToast('✅ Client added!');
      });

      function editClient(id) {
        // For now, just show a message
        showToast('Edit client coming soon!');
      }

      function deleteClient(id) {
        if (confirm('Delete this client?')) {
          clients = clients.filter(c => c.id !== id);
          localStorage.setItem('quote_clients_' + userId, JSON.stringify(clients));
          renderClients(clients);
          showToast('Client deleted');
        }
      }

      loadClients();
    </script>
  </body>
</html>
