---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quote Engine - Style 4</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0d0d12] text-white font-sans">
    <header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-sm">
      <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <span class="text-lg font-medium tracking-wide">QUOTE ENGINE</span>
        <nav class="flex items-center gap-6 text-sm">
          <a href="#" class="text-zinc-500 hover:text-white transition">Features</a>
          <a href="/dashboard" class="text-white hover:text-white transition">Dashboard</a>
        </nav>
      </div>
    </header>

    <main class="pt-32 px-6">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-16 items-center">
        <div>
          <h1 class="text-5xl font-bold leading-tight mb-6">
            Quotes that<br />
            <span class="text-cyan-400">actually work</span>
          </h1>
          <p class="text-lg text-zinc-400 mb-8 leading-relaxed">
            Automated quote generation powered by AI. Set your prices, define your rules, and generate professional quotes in seconds—not hours.
          </p>
          <div class="flex gap-4">
            <a href="/dashboard" class="bg-cyan-500 text-black px-6 py-3 rounded-lg font-semibold hover:bg-cyan-400 transition">Start Free</a>
            <a href="/auth/signin" class="border border-zinc-700 px-6 py-3 rounded-lg font-medium hover:border-zinc-500 transition">Sign In</a>
          </div>
        </div>
        
        <!-- Abstract visual -->
        <div class="relative">
          <div class="w-full aspect-square bg-gradient-to-br from-cyan-500/20 to-purple-500/20 rounded-3xl border border-white/10 flex items-center justify-center">
            <div class="text-center">
              <div class="text-6xl font-bold gradient-text mb-2">1000+</div>
              <div class="text-zinc-500">Quotes Generated</div>
            </div>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
.gradient-text {
  background: linear-gradient(135deg, #22d3ee, #a78bfa);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
</style>
