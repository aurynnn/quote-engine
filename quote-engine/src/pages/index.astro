---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quote Engine - AI-Powered Quote Generation</title>
    <meta name="description" content="Generate professional quotes in seconds with AI" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen">
    <!-- Background Pattern -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-emerald-900/20 via-slate-900/40 to-slate-950"></div>
      <div class="absolute top-0 left-1/4 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-violet-500/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Header -->
    <header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl border-b border-white/5">
      <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold gradient-text">Quote Engine</a>
        <nav class="hidden md:flex items-center gap-8 text-sm">
          <a href="#features" class="text-zinc-400 hover:text-white transition-colors">Features</a>
          <a href="#how-it-works" class="text-zinc-400 hover:text-white transition-colors">How It Works</a>
          <a href="/dashboard" class="text-zinc-400 hover:text-white transition-colors">Dashboard</a>
          <a href="/dashboard" class="btn-primary">Get Started</a>
        </nav>
      </div>
    </header>

    <main class="pt-32">
      <!-- Hero -->
      <section class="max-w-4xl mx-auto px-6 py-20 text-center animate-fade-in">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm mb-8">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          AI-Powered Quote Generation
        </div>
        
        <h1 class="text-5xl sm:text-6xl font-bold mb-6 leading-tight">
          Generate Professional Quotes<br />
          <span class="gradient-text">in Seconds</span>
        </h1>
        
        <p class="text-xl text-zinc-400 mb-10 max-w-2xl mx-auto">
          Upload your pricing, set your rules, and let AI create accurate quotes instantly. No more manual calculations.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/dashboard" class="btn-primary text-lg px-8 py-4">
            Start Now — It's Free
          </a>
          <a href="#how-it-works" class="btn-secondary text-lg">
            See How It Works
          </a>
        </div>
      </section>

      <!-- Features -->
      <section id="features" class="py-20">
        <div class="max-w-6xl mx-auto px-6">
          <div class="text-center mb-16">
            <h2 class="text-3xl font-bold mb-4">Why Quote Engine?</h2>
            <p class="text-zinc-400">Everything you need to generate professional quotes fast</p>
          </div>
          
          <div class="grid md:grid-cols-3 gap-6">
            <!-- Feature 1 -->
            <div class="card p-8">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-emerald-600 flex items-center justify-center mb-6">
                <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-3">Excel Import</h3>
              <p class="text-zinc-400">Simply upload your Excel pricing file and we parse it automatically into structured data.</p>
            </div>

            <!-- Feature 2 -->
            <div class="card p-8">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-violet-500 to-violet-600 flex items-center justify-center mb-6">
                <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-3">AI-Powered</h3>
              <p class="text-zinc-400">Smart quote generation using advanced AI to understand your requirements perfectly.</p>
            </div>

            <!-- Feature 3 -->
            <div class="card p-8">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center mb-6">
                <svg class="w-7 h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-3">Smart Rules</h3>
              <p class="text-zinc-400">Set minimums, buffers, discounts, and taxes. We apply them automatically.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- How It Works -->
      <section id="how-it-works" class="py-20 bg-white/5">
        <div class="max-w-4xl mx-auto px-6">
          <div class="text-center mb-16">
            <h2 class="text-3xl font-bold mb-4">How It Works</h2>
            <p class="text-zinc-400">Three simple steps to professional quotes</p>
          </div>
          
          <div class="flex flex-col md:flex-row gap-8">
            <div class="flex-1 text-center">
              <div class="w-16 h-16 rounded-2xl bg-emerald-500/20 text-emerald-400 text-2xl font-bold flex items-center justify-center mx-auto mb-4">1</div>
              <h3 class="text-lg font-semibold mb-2">Upload Pricing</h3>
              <p class="text-zinc-500">Upload your Excel file with prices, categories, and units.</p>
            </div>
            <div class="flex-1 text-center">
              <div class="w-16 h-16 rounded-2xl bg-violet-500/20 text-violet-400 text-2xl font-bold flex items-center justify-center mx-auto mb-4">2</div>
              <h3 class="text-lg font-semibold mb-2">Set Rules</h3>
              <p class="text-zinc-500">Configure minimums, buffers, and discounts.</p>
            </div>
            <div class="flex-1 text-center">
              <div class="w-16 h-16 rounded-2xl bg-amber-500/20 text-amber-400 text-2xl font-bold flex items-center justify-center mx-auto mb-4">3</div>
              <h3 class="text-lg font-semibold mb-2">Generate Quotes</h3>
              <p class="text-zinc-500">Describe what you need and get a professional quote instantly.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="py-20">
        <div class="max-w-3xl mx-auto px-6 text-center">
          <h2 class="text-3xl font-bold mb-6">Ready to Get Started?</h2>
          <p class="text-zinc-400 mb-8">Join thousands of businesses generating quotes faster than ever.</p>
          <a href="/dashboard" class="btn-primary text-lg inline-block">
            Start Generating Quotes
          </a>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/5 py-8">
      <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-zinc-500">
        <span>© 2026 Quote Engine. All rights reserved.</span>
        <div class="flex items-center gap-6">
          <a href="#" class="hover:text-white transition-colors">Privacy</a>
          <a href="#" class="hover:text-white transition-colors">Terms</a>
        </div>
      </div>
    </footer>
  </body>
</html>
