---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quote Engine - Smart Quotes for Smart Business</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-[#0a0a0f] text-white font-sans">
    <!-- Background -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-red-500/10 rounded-full blur-[100px]"></div>
      <div class="absolute inset-0" id="stars"></div>
    </div>

    <header class="relative z-10">
      <div class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-8 h-8 bg-gradient-to-br from-red-400 to-rose-500 rounded-lg"></div>
          <span class="text-xl font-semibold">Quote Engine</span>
        </div>
        <nav class="flex items-center gap-6 text-sm">
          <a href="#features" class="text-zinc-400 hover:text-white transition">Features</a>
          <a href="/dashboard" class="bg-white text-black px-4 py-2 rounded-lg font-medium hover:bg-zinc-100 transition">Launch App</a>
        </nav>
      </div>
    </header>

    <main class="relative z-10 pt-24">
      <section class="max-w-4xl mx-auto px-6 text-center">
        <!-- Badge from style 2 -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 text-sm mb-8">
          ✨ AI-Powered
        </div>
        
        <!-- Title from user request -->
        <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">
          Smart Quotes for<br />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-rose-400 to-pink-400">
            Smart Business
          </span>
        </h1>
        
        <p class="text-xl text-zinc-400 mb-12 max-w-xl mx-auto">
          Upload your pricing, set your rules, and let AI create accurate quotes instantly. No more manual calculations.
        </p>
        
        <!-- Red button like version 3 -->
        <div class="flex flex-col items-center gap-6 mb-16">
          <a href="/dashboard" class="group relative inline-flex items-center justify-center px-10 py-5 text-xl font-bold text-white bg-gradient-to-r from-red-500 to-rose-500 rounded-2xl overflow-hidden transition-transform hover:scale-105 hover:shadow-lg hover:shadow-red-500/25">
            <span class="relative z-10">Start Generating Free</span>
            <div class="absolute inset-0 bg-gradient-to-r from-red-600 to-rose-600 opacity-0 group-hover:opacity-100 transition-opacity"></div>
          </a>
          <p class="text-zinc-500 text-sm">No signup required to try</p>
        </div>
        
        <!-- Stats like 5 -->
        <div class="grid grid-cols-3 gap-8 pt-8 border-t border-zinc-800">
          <div class="text-center">
            <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-rose-400">10s</div>
            <div class="text-zinc-500 text-sm mt-1">Generate time</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-rose-400">99%</div>
            <div class="text-zinc-500 text-sm mt-1">Accuracy</div>
          </div>
          <div class="text-center">
            <div class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-red-400 to-rose-400">Free</div>
            <div class="text-zinc-500 text-sm mt-1">To start</div>
          </div>
        </div>
      </section>

      <!-- Features -->
      <section id="features" class="max-w-5xl mx-auto px-6 mt-24 pb-20">
        <div class="grid md:grid-cols-3 gap-6">
          <div class="p-6 bg-white/5 border border-white/10 rounded-2xl">
            <div class="w-12 h-12 bg-gradient-to-br from-red-500 to-rose-500 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Excel Import</h3>
            <p class="text-zinc-500 text-sm">Upload your pricing file and we parse it automatically.</p>
          </div>
          
          <div class="p-6 bg-white/5 border border-white/10 rounded-2xl">
            <div class="w-12 h-12 bg-gradient-to-br from-pink-500 to-rose-500 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Instant Generation</h3>
            <p class="text-zinc-500 text-sm">Describe what you need and get a quote in seconds.</p>
          </div>
          
          <div class="p-6 bg-white/5 border border-white/10 rounded-2xl">
            <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-500 rounded-xl flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold mb-2">Smart Pricing</h3>
            <p class="text-zinc-500 text-sm">Rules and margins applied automatically.</p>
          </div>
        </div>
      </section>
    </main>

    <!-- Footer -->
    <footer class="relative z-10 border-t border-zinc-800 py-8">
      <div class="max-w-6xl mx-auto px-6 text-center text-zinc-500 text-sm">
        © 2026 Quote Engine. All rights reserved.
      </div>
    </footer>

    <!-- Stars -->
    <script>
      const stars = document.getElementById('stars');
      for (let i = 0; i < 80; i++) {
        const star = document.createElement('div');
        star.className = 'absolute w-1 h-1 bg-white rounded-full';
        star.style.left = Math.random() * 100 + '%';
        star.style.top = Math.random() * 100 + '%';
        star.style.opacity = Math.random() * 0.5 + 0.2;
        star.style.animation = `twinkle ${Math.random() * 3 + 2}s infinite`;
        stars.appendChild(star);
      }
    </script>
    
    <style>
      @keyframes twinkle {
        0%, 100% { opacity: 0.2; }
        50% { opacity: 0.8; }
      }
    </style>
  </body>
</html>
